import NS25Lean.AppendixBHeight

set_option linter.style.header false
noncomputable section
namespace NS25Lean.L4A
open ChosenBase L2C Presentation ToricPresentation MvPolynomial
variable {Gamma : NumericalSemigroup} {B : Data Gamma}
namespace NormalizedPairs

/-- The three literal source binomials, in the original four-variable polynomial ring. -/
def threeBinomialIdeal (N : NormalizedPairs B) (K : Type*) [Field K] (r s k l : ℕ) :
    Ideal (MvPolynomial (Fin 4) K) :=
  Ideal.span {X (N.perm 0) ^ N.beta - X (N.perm 1) ^ N.alpha,
    X (N.perm 2) ^ N.delta - X (N.perm 3) ^ N.gamma,
    X (N.perm 0) ^ r * X (N.perm 1) ^ s - X (N.perm 2) ^ k * X (N.perm 3) ^ l}

theorem threeBinomialIdeal_eq (N : NormalizedPairs B) (K : Type*) [Field K] (r s k l : ℕ)
    (hvr : N.v = N.alpha * r + N.beta * s) (huk : N.u = N.gamma * k + N.delta * l) :
    N.threeBinomialIdeal K r s k l = toricIdeal K Gamma.toAddSubmonoid B.family := by
  rw [← N.sourceRelations_generate_toricIdeal K r s k l hvr huk]
  simp [threeBinomialIdeal, relationIdeal, sourceRelations, relationBinomial,
    X_pow_eq_monomial, monomial_mul, Set.image_insert_eq, Set.image_singleton]
  rfl

theorem three_generator_number_le (N : NormalizedPairs B) (K : Type*) [Field K] (r s k l : ℕ)
    (hvr : N.v = N.alpha * r + N.beta * s) (huk : N.u = N.gamma * k + N.delta * l) :
    toricGeneratorNumber K Gamma.toAddSubmonoid B.family ≤ 3 := by
  have h := toricGeneratorNumber_le_card_of_presentation K Gamma.toAddSubmonoid B.family
    (N.sourceRelations r s k l) (N.sourceRelations_presentation r s k l hvr huk)
  apply h.trans
  unfold sourceRelations
  exact (Finset.card_insert_le _ _).trans
    (Nat.succ_le_succ ((Finset.card_insert_le _ _).trans (by simp)))

theorem three_binomial_height_and_number (N : NormalizedPairs B) (K : Type*) [Field K]
    (r s k l : ℕ) (hvr : N.v = N.alpha * r + N.beta * s)
    (huk : N.u = N.gamma * k + N.delta * l) :
    (toricIdeal K Gamma.toAddSubmonoid B.family).height = 3 ∧
      toricGeneratorNumber K Gamma.toAddSubmonoid B.family = 3 := by
  have hn := N.three_generator_number_le K r s k l hvr huk
  haveI : (toricIdeal K Gamma.toAddSubmonoid B.family).IsPrime := RingHom.ker_isPrime _
  have hl := Ideal.height_le_spanFinrank (toricIdeal K Gamma.toAddSubmonoid B.family)
    (Ideal.IsPrime.ne_top inferInstance)
  have hg := toric_height_ge_three K B
  have hcast : ((toricGeneratorNumber K Gamma.toAddSubmonoid B.family : ℕ) : ℕ∞) ≤ 3 := by
    exact_mod_cast hn
  have he : (toricIdeal K Gamma.toAddSubmonoid B.family).height = 3 :=
    le_antisymm (hl.trans hcast) hg
  refine ⟨he, le_antisymm hn ?_⟩
  rw [he] at hl
  exact_mod_cast hl

end NormalizedPairs

/-- Algebraic CI evidence: the actual original toric ideal is generated by the
three displayed source binomials and has height three. -/
structure CompleteIntersectionFourData (K : Type*) [Field K] (B : Data Gamma) where
  normalization : NormalizedPairs B
  r : ℕ
  s : ℕ
  k : ℕ
  l : ℕ
  cross_v : normalization.v = normalization.alpha * r + normalization.beta * s
  cross_u : normalization.u = normalization.gamma * k + normalization.delta * l
  generates : normalization.threeBinomialIdeal K r s k l = toricIdeal K Gamma.toAddSubmonoid B.family
  height_three : (toricIdeal K Gamma.toAddSubmonoid B.family).height = 3

/-- Field-independent algebraic complete-intersection assertion, with proof payloads. -/
def IsCompleteIntersectionFour (B : Data Gamma) : Prop :=
  ∀ (K : Type) [Field K], Nonempty (CompleteIntersectionFourData K B)

theorem symmetric_complete_intersection_data (N : NormalizedPairs B) (he : N.a = N.b)
    (K : Type*) [Field K] : Nonempty (CompleteIntersectionFourData K B) := by
  obtain ⟨r, s, k, l, hvr, huk⟩ := N.symmetric_cross_representations he
  exact ⟨⟨N, r, s, k, l, hvr, huk, N.threeBinomialIdeal_eq K r s k l hvr huk,
    (N.three_binomial_height_and_number K r s k l hvr huk).1⟩⟩

theorem symmetric_complete_intersection (N : NormalizedPairs B) (he : N.a = N.b) :
    IsCompleteIntersectionFour B := fun K _ => symmetric_complete_intersection_data N he K

theorem completeIntersectionFour_rho (h : IsCompleteIntersectionFour B) : rho Gamma = 3 := by
  obtain ⟨D⟩ := h ℚ
  rw [rho_eq_presentationNumber_of_minimal_degrees Gamma B.family B.generates B.positive B.minimal,
    presentationNumber_eq_toricGeneratorNumber ℚ Gamma.toAddSubmonoid B.family B.positive]
  exact (D.normalization.three_binomial_height_and_number ℚ D.r D.s D.k D.l D.cross_v D.cross_u).2

end NS25Lean.L4A
