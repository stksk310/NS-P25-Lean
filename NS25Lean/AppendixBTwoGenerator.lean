import NS25Lean.FourBasePreparation
import Mathlib.RingTheory.Coprime.Lemmas

set_option linter.style.header false
noncomputable section
namespace NS25Lean.L4A

/-- The actual additive submonoid generated by the two displayed natural numbers. -/
def twoGenerator (A B : ℕ) : AddSubmonoid ℕ := AddSubmonoid.closure {A, B}

/-- Integer membership uses nonnegative coefficients, without truncated subtraction. -/
def twoGeneratorInt (A B : ℕ) (z : ℤ) : Prop :=
  ∃ r s : ℕ, z = (A : ℤ) * r + (B : ℤ) * s

theorem mem_twoGenerator (A B n : ℕ) :
    n ∈ twoGenerator A B ↔ ∃ r s : ℕ, n = A * r + B * s := by
  simp only [twoGenerator, AddSubmonoid.mem_closure_pair, nsmul_eq_mul]
  constructor
  · rintro ⟨r, s, he⟩
    exact ⟨r, s, by nlinarith [he]⟩
  · rintro ⟨r, s, he⟩
    exact ⟨r, s, by nlinarith [he]⟩

theorem twoGeneratorInt_nat (A B n : ℕ) :
    twoGeneratorInt A B n ↔ n ∈ twoGenerator A B := by
  rw [mem_twoGenerator]
  constructor
  · rintro ⟨r, s, he⟩
    exact ⟨r, s, by exact_mod_cast he⟩
  · rintro ⟨r, s, he⟩
    exact ⟨r, s, by exact_mod_cast he⟩

theorem twoGeneratorInt_iff_IntMem (A B : ℕ) (z : ℤ) :
    twoGeneratorInt A B z ↔ FourGeneratedBridge.IntMem (twoGenerator A B) z := by
  constructor
  · rintro ⟨r, s, he⟩
    exact ⟨A * r + B * s, (mem_twoGenerator A B _).mpr ⟨r, s, rfl⟩, by simpa using he⟩
  · rintro ⟨n, hn, rfl⟩
    exact (twoGeneratorInt_nat A B n).mpr hn

/-- A least-residue representative and an unrestricted integer coefficient. -/
theorem two_generator_normal_form (A B : ℕ) (ha : 0 < A) (hc : A.Coprime B) (z : ℤ) :
    ∃ j k : ℤ, 0 ≤ j ∧ j < A ∧ z = (A : ℤ) * k + (B : ℤ) * j := by
  obtain ⟨p, q, hpq⟩ := hc.isCoprime
  have ha' : (0 : ℤ) < A := by exact_mod_cast ha
  refine ⟨(z * q) % A, z * p + B * ((z * q) / A),
    Int.emod_nonneg _ (ne_of_gt ha'), Int.emod_lt_of_pos _ ha', ?_⟩
  have he := Int.emod_add_mul_ediv (z * q) (A : ℤ)
  nlinarith [congrArg (fun t : ℤ => z * t) hpq]

theorem two_generator_normal_mem_iff (A B : ℕ) (ha : 0 < A) (hc : A.Coprime B)
    (z j k : ℤ) (hj : 0 ≤ j) (hjA : j < A)
    (hz : z = (A : ℤ) * k + (B : ℤ) * j) :
    twoGeneratorInt A B z ↔ 0 ≤ k := by
  have ha' : (0 : ℤ) < A := by exact_mod_cast ha
  constructor
  · rintro ⟨r, s, he⟩
    have hd : (A : ℤ) ∣ (s : ℤ) - j := hc.isCoprime.dvd_of_dvd_mul_left
      ⟨k - r, by nlinarith [hz, he]⟩
    obtain ⟨t, ht⟩ := hd
    have ht0 : 0 ≤ t := by
      by_contra hn
      have ht1 : t ≤ -1 := by omega
      have hmul := mul_le_mul_of_nonneg_left ht1 (le_of_lt ha')
      have hs0 : (0 : ℤ) ≤ s := by positivity
      nlinarith
    have hk : k = (r : ℤ) + (B : ℤ) * t := by nlinarith [hz, he, ht]
    rw [hk]
    positivity
  · intro hk
    exact ⟨k.toNat, j.toNat, by simpa only [Int.toNat_of_nonneg hk, Int.toNat_of_nonneg hj] using hz⟩

/-- Source two-generator symmetry for every integer, including negative integers. -/
theorem two_generator_symmetry (A B : ℕ) (ha : 0 < A) (hb : 0 < B)
    (hc : A.Coprime B) (z : ℤ) :
    ¬ twoGeneratorInt A B z ↔
      twoGeneratorInt A B ((A : ℤ) * B - A - B - z) := by
  obtain ⟨j, k, hj, hjA, hz⟩ := two_generator_normal_form A B ha hc z
  have hF : (A : ℤ) * B - A - B - z =
      (A : ℤ) * (-k - 1) + (B : ℤ) * ((A : ℤ) - 1 - j) := by nlinarith [hz]
  rw [two_generator_normal_mem_iff A B ha hc z j k hj hjA hz,
    two_generator_normal_mem_iff A B ha hc _ ((A : ℤ) - 1 - j) (-k - 1)
      (by omega) (by omega) hF]
  omega

/-- Equal weights in a coprime pair differ by its primitive integer relation. -/
theorem two_generator_difference (A B x y x' y' : ℕ)
    (hb : 0 < B) (hc : A.Coprime B) (he : A*x+B*y = A*x'+B*y') :
    ∃ t : ℤ, (x' : ℤ) - x = (B : ℤ) * t ∧
      (y' : ℤ) - y = -(A : ℤ) * t := by
  have he' : (A : ℤ)*x+B*y = (A : ℤ)*x'+B*y' := by exact_mod_cast he
  have hd : (B : ℤ) ∣ (x' : ℤ) - x := hc.symm.isCoprime.dvd_of_dvd_mul_left
    ⟨(y : ℤ)-y', by nlinarith [he']⟩
  obtain ⟨t, ht⟩ := hd
  refine ⟨t, ht, ?_⟩
  have hb' : (0 : ℤ) < B := by exact_mod_cast hb
  nlinarith [he', ht]

/-- At the product degree a coprime pair has only its two pure endpoints. -/
theorem two_generator_product_solutions (A B x y : ℕ) (ha : 0 < A) (hb : 0 < B)
    (hc : A.Coprime B) (he : A*x+B*y = A*B) :
    (x = B ∧ y = 0) ∨ (x = 0 ∧ y = A) := by
  have hd : A ∣ y := hc.dvd_of_dvd_mul_left
    (by have hsum : A ∣ A*x+B*y := he ▸ dvd_mul_right A B
        exact (Nat.dvd_add_right (dvd_mul_right A x)).mp hsum)
  obtain ⟨t, ht⟩ := hd
  have hxt : x + B*t = B := by nlinarith [he, ht]
  have ht1 : t ≤ 1 := by nlinarith
  interval_cases t
  · left
    constructor <;> nlinarith [ht, hxt]
  · right
    constructor <;> nlinarith [ht, hxt]

/-- The exact gcd cancellation used in the protected-pivot divisibility bridge. -/
theorem gcd_divisibility_bridge (A v r : ℕ) (ha : 0 < A) :
    A ∣ v*r ↔ A / A.gcd v ∣ r := by
  let g := A.gcd v
  have hg : 0 < g := Nat.gcd_pos_of_pos_left v ha
  have hA : g * (A / g) = A := Nat.mul_div_cancel' (Nat.gcd_dvd_left A v)
  have hv : g * (v / g) = v := Nat.mul_div_cancel' (Nat.gcd_dvd_right A v)
  have hc : (A/g).Coprime (v/g) := Nat.coprime_div_gcd_div_gcd hg
  constructor
  · intro hd
    have hmul : A/g ∣ (v/g)*r := by
      apply Nat.dvd_of_mul_dvd_mul_left hg
      simpa only [← mul_assoc, hA, hv] using hd
    exact hc.dvd_of_dvd_mul_left hmul
  · rintro ⟨t, rfl⟩
    refine ⟨(v/g)*t, ?_⟩
    change v * ((A/g)*t) = A*((v/g)*t)
    calc
      _ = (g*(v/g))*((A/g)*t) := by rw [hv]
      _ = (g*(A/g))*((v/g)*t) := by ring
      _ = _ := by rw [hA]

end NS25Lean.L4A



