import NS25Lean.BoundarySourceClasses

set_option linter.style.header false
noncomputable section
namespace NS25Lean.L2B2A2
open NS25Lean.L2B NS25Lean.L2B2A ChosenBase Presentation ToricPresentation
  FourGeneratedBridge MvPolynomial
variable {Gamma : NumericalSemigroup}

instance sourceFintype (B : Data Gamma) : Fintype (Source B) := Fintype.ofFinite _

def boundaryMonomials (k : Type*) [Field k] (B : Data Gamma) : Set (Poly k 3) :=
  {f | ∃ u : Fin 3 →₀ ℕ, weight B u ∈ B.K ∧ f = monomial u 1}

theorem MK_eq_span_boundaryMonomials (k : Type*) [Field k] (B : Data Gamma) :
    (B.MK k).restrictScalars k = Submodule.span k (boundaryMonomials k B) := by
  have he : B.MK k = Ideal.span (boundaryMonomials k B) := by
    unfold Data.MK boundaryMonomials
    congr 1
    ext f
    constructor
    · rintro ⟨u, hu, rfl⟩
      exact ⟨u, by rwa [weight_eq_degree B u], rfl⟩
    · rintro ⟨u, hu, rfl⟩
      refine ⟨u, ?_, rfl⟩
      change (factorizationMap B.tailDegrees u).val ∈ B.K
      rwa [← weight_eq_degree B u]
  rw [he]
  apply ideal_span_restrict_eq_span
  rintro a f ⟨u, hu, rfl⟩
  refine ⟨a + u, ?_, by simp only [monomial_mul, one_mul]⟩
  rw [map_add, add_comm]
  exact aperyTail_add_mem B.H_le hu
    ((weight_eq_degree B a).symm ▸ (factorizationMap B.tailDegrees a).property)

theorem J_eq_span_moves (k : Type*) [Field k] (B : Data Gamma) :
    (B.J k).restrictScalars k =
      Submodule.span k (toricMoves k B ∪ boundaryMonomials k B) := by
  rw [B.J_eq_IH_sup_MK k, Submodule.restrictScalars_sup, IH_eq_span_toricMoves,
    MK_eq_span_boundaryMonomials, Submodule.span_union]

theorem map_mem_of_spanning {R V W : Type*} [CommRing R]
    [AddCommGroup V] [Module R V] [AddCommGroup W] [Module R W]
    (P : Submodule R V) (s : Set V) (hs : P = Submodule.span R s)
    (f : P →ₗ[R] W) (Q : Submodule R W)
    (h : ∀ x : P, x.val ∈ s → f x ∈ Q) (x : P) : f x ∈ Q := by
  have hspan : Submodule.span R (Subtype.val ⁻¹' s : Set P) = ⊤ := by
    subst P
    exact Submodule.span_span_coe_preimage
  have hle : (⊤ : Submodule R P) ≤ Q.comap f := by
    rw [← hspan]
    exact Submodule.span_le.mpr h
  exact hle (Submodule.mem_top : x ∈ (⊤ : Submodule R P))

/-- All boundary quotient classes are generated by the minimal source classes. -/
theorem span_sourceClass_eq_top (k : Type*) [Field k] (M : MultiplicityBase Gamma) :
    Submodule.span k (Set.range (sourceClass k M)) = ⊤ := by
  classical
  let S := Submodule.span k (Set.range (sourceClass k M))
  have hP : ∀ f : M.base.J k, boundaryClass k M f ∈ S := by
    apply map_mem_of_spanning ((M.base.J k).restrictScalars k)
      (toricMoves k M.base ∪ boundaryMonomials k M.base) (J_eq_span_moves k M.base)
      (boundaryClass k M) S
    rintro ⟨f, hfJ⟩ hf
    rcases hf with ⟨u, v, he, rfl⟩ | ⟨u, hu, rfl⟩
    · have hz := boundaryClass_IH k M
        ⟨monomial u 1 - monomial v 1, hfJ⟩ (binomial_mem_IH k M.base u v he)
      exact hz.symm ▸ S.zero_mem
    · by_cases hs : IsMinimalTailGenerator M.base.H M.base.K (weight M.base u)
      · have he := boundaryClass_monomial_source k M u hu hs
        have hm : sourceClass k M ⟨weight M.base u, hs⟩ ∈ S :=
          Submodule.subset_span ⟨⟨weight M.base u, hs⟩, rfl⟩
        exact he.symm ▸ hm
      · exact (boundaryClass_monomial_nonminimal k M u hu hs).symm ▸ S.zero_mem
  apply top_unique
  intro q _
  obtain ⟨f, rfl⟩ := boundaryClass_surjective k M q
  exact hP f
def sourceSection (k : Type*) [Field k] (M : MultiplicityBase Gamma) :
    (Source M.base → k) →ₗ[k] BoundaryGeneratorQuotient k M :=
  (Pi.basisFun k (Source M.base)).constr k (sourceClass k M)

theorem sourceSection_unit (k : Type*) [Field k] (M : MultiplicityBase Gamma)
    (x : Source M.base) : sourceSection k M (Pi.single x 1) = sourceClass k M x := by
  simpa only [sourceSection, Pi.basisFun_apply] using
    (Pi.basisFun k (Source M.base)).constr_basis k (sourceClass k M) x

theorem sourceSection_leftInverse (k : Type*) [Field k] (M : MultiplicityBase Gamma) :
    (boundarySourceCoordinates k M).comp (sourceSection k M) = LinearMap.id := by
  apply (Pi.basisFun k (Source M.base)).ext
  intro x
  simp only [LinearMap.comp_apply, LinearMap.id_apply, Pi.basisFun_apply]
  rw [sourceSection_unit, sourceClass_coordinates]

theorem sourceSection_surjective (k : Type*) [Field k] (M : MultiplicityBase Gamma) :
    Function.Surjective (sourceSection k M) := by
  rw [← LinearMap.range_eq_top]
  apply top_unique
  rw [← span_sourceClass_eq_top k M]
  apply Submodule.span_le.mpr
  rintro _ ⟨x, rfl⟩
  exact ⟨Pi.single x 1, sourceSection_unit k M x⟩

/-- An explicit linear equivalence from minimal-source coordinates to the actual
quotient (J/nJ)/image(I_H). Both generation and independence are proved. -/
def boundarySourceEquiv (k : Type*) [Field k] (M : MultiplicityBase Gamma) :
    (Source M.base → k) ≃ₗ[k] BoundaryGeneratorQuotient k M :=
  LinearEquiv.ofBijective (sourceSection k M)
    ⟨fun x y he => by
      have hh := congrArg (boundarySourceCoordinates k M) he
      have hl := LinearMap.congr_fun (sourceSection_leftInverse k M)
      exact (hl x).symm.trans (hh.trans (hl y)),
      sourceSection_surjective k M⟩

theorem boundaryGeneratorQuotient_finrank_eq_sourceCount (k : Type*) [Field k]
    (M : MultiplicityBase Gamma) :
    Module.finrank k (BoundaryGeneratorQuotient k M) = sourceCount M.base := by
  rw [← (boundarySourceEquiv k M).finrank_eq]
  rw [Module.finrank_fintype_fun_eq_card]
  exact Nat.card_eq_fintype_card.symm

end NS25Lean.L2B2A2

