import NS25Lean.WeightedResidueLattice

set_option linter.style.header false
noncomputable section
namespace NS25Lean.L2B
open ChosenBase FourGeneratedBridge
variable {Gamma : NumericalSemigroup}

def dilatedDegrees (B : Data Gamma) (D : ℕ) : Fin 4 → ℕ :=
  Fin.cases B.q.val (fun j => D * weights B j)

/-- Actual additive submonoid generated by q and the dilated tail. -/
def dilatedMonoid (B : Data Gamma) (D : ℕ) : AddSubmonoid ℕ where
  carrier := {n | ∃ r h : ℕ, h ∈ B.H ∧ n = r * B.q.val + D * h}
  zero_mem' := ⟨0, 0, B.H.zero_mem, by simp⟩
  add_mem' := by
    rintro _ _ ⟨r, h, hh, rfl⟩ ⟨s, g, hg, rfl⟩
    exact ⟨r + s, h + g, B.H.add_mem hh hg, by ring⟩

theorem q_mem_dilated (B : Data Gamma) (D : ℕ) : B.q.val ∈ dilatedMonoid B D :=
  ⟨1, 0, B.H.zero_mem, by simp⟩

theorem tail_mem_dilated (B : Data Gamma) (D : ℕ) {h : ℕ} (hh : h ∈ B.H) :
    D * h ∈ dilatedMonoid B D := ⟨0, h, hh, by simp⟩

theorem dilatedMonoid_eq_closure (B : Data Gamma) (D : ℕ) :
    dilatedMonoid B D = AddSubmonoid.closure (Set.range (dilatedDegrees B D)) := by
  apply le_antisymm
  · rintro n ⟨r, h, hh, rfl⟩
    have hq : B.q.val ∈ AddSubmonoid.closure (Set.range (dilatedDegrees B D)) :=
      AddSubmonoid.subset_closure ⟨0, rfl⟩
    have ht : D * h ∈ AddSubmonoid.closure (Set.range (dilatedDegrees B D)) := by
      induction hh using AddSubmonoid.closure_induction with
      | mem h hh =>
          obtain ⟨j, rfl⟩ := hh
          exact AddSubmonoid.subset_closure ⟨j.succ, rfl⟩
      | zero => simpa using (AddSubmonoid.closure (Set.range (dilatedDegrees B D))).zero_mem
      | add a b ha hb iha ihb =>
          simpa only [Nat.mul_add] using AddSubmonoid.add_mem _ iha ihb
    exact AddSubmonoid.add_mem _ (by simpa [nsmul_eq_mul] using
      (AddSubmonoid.closure (Set.range (dilatedDegrees B D))).nsmul_mem hq r) ht
  · apply AddSubmonoid.closure_le.mpr
    rintro _ ⟨i, rfl⟩
    refine Fin.cases (q_mem_dilated B D) (fun j => ?_) i
    exact tail_mem_dilated B D (B.tailDegrees j).property

theorem common_divisor_dilated (B : Data Gamma) (D d : ℕ) (hcop : Nat.Coprime D B.q.val)
    (hd : ∀ i, d ∣ dilatedDegrees B D i) : d ∣ 1 := by
  have hdq : d ∣ B.q.val := hd 0
  have hall : ∀ n ∈ Gamma.toAddSubmonoid, d ∣ D * n := by
    intro n hn
    rw [← B.degrees_generate_nat] at hn
    induction hn using AddSubmonoid.closure_induction with
    | mem n hn =>
        obtain ⟨i, rfl⟩ := hn
        refine Fin.cases ?_ (fun j => hd j.succ) i
        simpa only [B.degrees_zero] using dvd_mul_of_dvd_right hdq D
    | zero => simp
    | add a b ha hb iha ihb => simpa only [Nat.mul_add] using dvd_add iha ihb
  obtain ⟨c, hc⟩ := Gamma.exists_conductor
  have hdc := hall c (hc c le_rfl)
  have hdcs := hall (c + 1) (hc (c + 1) (by omega))
  have hdD : d ∣ D := by
    have hs := Nat.dvd_sub hdcs hdc
    simpa [Nat.mul_add] using hs
  simpa only [hcop.gcd_eq_one] using Nat.dvd_gcd hdD hdq

theorem dilated_finite_compl (B : Data Gamma) (D : ℕ) (hcop : Nat.Coprime D B.q.val) :
    Set.Finite {n | n ∉ dilatedMonoid B D} := by
  have hgcd : Nat.setGcd (Set.range (dilatedDegrees B D)) = 1 := by
    apply Nat.dvd_one.mp
    exact common_divisor_dilated B D _ hcop (fun i => Nat.setGcd_dvd_of_mem ⟨i, rfl⟩)
  obtain ⟨N, hN⟩ := Nat.exists_mem_closure_of_ge (Set.range (dilatedDegrees B D))
  apply (Set.finite_lt_nat N).subset
  intro n hn
  by_contra hlt
  apply hn
  rw [dilatedMonoid_eq_closure]
  exact hN n (by simpa using hlt) (by simp [hgcd])

def dilatedSemigroup (B : Data Gamma) (D : ℕ) (hcop : Nat.Coprime D B.q.val) :
    NumericalSemigroup where
  toAddSubmonoid := dilatedMonoid B D
  finite_compl := dilated_finite_compl B D hcop

theorem dilated_multiplicity (B : Data Gamma) (D : ℕ) (hD : B.q.val < D) :
    ∀ n ∈ dilatedMonoid B D, n ≠ 0 → B.q.val ≤ n := by
  rintro n ⟨r, h, hh, rfl⟩ hn
  by_cases hr : r = 0
  · subst r
    have hhpos : 0 < h := by
      by_contra hz
      have he : h = 0 := by omega
      simp [he] at hn
    nlinarith [B.q_positive]
  · have hmul : B.q.val ≤ r * B.q.val := Nat.le_mul_of_pos_left _ (by omega)
    omega

end NS25Lean.L2B
