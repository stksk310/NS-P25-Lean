import NS25Lean.SharpnessFamily

set_option linter.style.header false

/-!
# The Apéry-tail bridge for four generators

The auxiliary monoid generated by three of the four generators need not have
finite complement.  Accordingly this file starts directly with arbitrary
additive submonoids of `ℕ`, independently of `NumericalSemigroup` and
`RelativeIdeal`.
-/

namespace NS25Lean
namespace FourGeneratedBridge

/-- The natural-number Apéry set.  The disjunction handles `w < m` without
using subtraction in `ℤ`. -/
def aperySet (Gamma : AddSubmonoid ℕ) (m : ℕ) : Set ℕ :=
  {w | w ∈ Gamma ∧ (w < m ∨ w - m ∉ Gamma)}

/-- The Apéry-tail set `K_Gamma = {h in H | h-m in Gamma}`.  The condition
`m ≤ h` records that the paper's subtraction is integer subtraction. -/
def aperyTail (Gamma H : AddSubmonoid ℕ) (m : ℕ) : Set ℕ :=
  {h | h ∈ H ∧ m ≤ h ∧ h - m ∈ Gamma}

@[simp] theorem mem_aperySet_iff (Gamma : AddSubmonoid ℕ) (m w : ℕ) :
    w ∈ aperySet Gamma m ↔
      w ∈ Gamma ∧ (w < m ∨ w - m ∉ Gamma) := Iff.rfl

@[simp] theorem mem_aperyTail_iff (Gamma H : AddSubmonoid ℕ) (m h : ℕ) :
    h ∈ aperyTail Gamma H m ↔
      h ∈ H ∧ m ≤ h ∧ h - m ∈ Gamma := Iff.rfl

/-- The Apéry tail is stable under addition by `H`, provided `H ⊆ Gamma`. -/
theorem aperyTail_add_mem {Gamma H : AddSubmonoid ℕ} {m h h' : ℕ}
    (hHGamma : H ≤ Gamma) (hh : h ∈ aperyTail Gamma H m) (hh' : h' ∈ H) :
    h + h' ∈ aperyTail Gamma H m := by
  rcases hh with ⟨hhH, hmh, hhGamma⟩
  refine ⟨H.add_mem hhH hh', by omega, ?_⟩
  have hadd := Gamma.add_mem hhGamma (hHGamma hh')
  convert hadd using 1 <;> omega

/-- A decomposition hypothesis expressing `Gamma = ⟨m,H⟩` at the level
needed by the Apéry-tail argument. -/
def IsGeneratedOver (Gamma H : AddSubmonoid ℕ) (m : ℕ) : Prop :=
  ∀ w : ℕ, w ∈ Gamma → ∃ q h : ℕ, h ∈ H ∧ w = q * m + h

/-- The central Apéry-tail identity from the four-generated reduction. -/
theorem relative_compl_aperyTail_eq_aperySet
    {Gamma H : AddSubmonoid ℕ} {m : ℕ}
    (hmpos : 0 < m) (hmGamma : m ∈ Gamma) (hHGamma : H ≤ Gamma)
    (hgen : IsGeneratedOver Gamma H m) :
    {w : ℕ | w ∈ H ∧ w ∉ aperyTail Gamma H m} = aperySet Gamma m := by
  ext w
  constructor
  · rintro ⟨hwH, hwNotTail⟩
    refine ⟨hHGamma hwH, ?_⟩
    by_cases hwm : w < m
    · exact Or.inl hwm
    · right
      intro hsub
      apply hwNotTail
      exact ⟨hwH, by omega, hsub⟩
  · rintro ⟨hwGamma, hwAp⟩
    obtain ⟨q, h, hhH, hw⟩ := hgen w hwGamma
    have hqzero : q = 0 := by
      by_contra hq
      have hqpos : 1 ≤ q := Nat.one_le_iff_ne_zero.2 hq
      have hsubGamma : w - m ∈ Gamma := by
        have hmul := Gamma.nsmul_mem hmGamma (q - 1)
        have hadd := Gamma.add_mem hmul (hHGamma hhH)
        have hqm : q * m = (q - 1) * m + m := by
          calc
            q * m = ((q - 1) + 1) * m := by rw [Nat.sub_add_cancel hqpos]
            _ = (q - 1) * m + m := by simp [Nat.add_mul]
        rw [hw, hqm]
        convert hadd using 1 <;> simp [nsmul_eq_mul, Nat.add_sub_cancel_left,
          Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
      rcases hwAp with hlt | hnot
      · have hmle : m ≤ w := by
          rw [hw]
          have : m ≤ q * m := by
            calc
              m = 1 * m := by simp
              _ ≤ q * m := Nat.mul_le_mul_right m hqpos
          omega
        omega
      · exact hnot hsubGamma
    subst q
    have hwh : w = h := by simpa using hw
    subst h
    refine ⟨hhH, ?_⟩
    intro htail
    rcases htail with ⟨-, hmle, hsub⟩
    rcases hwAp with hlt | hnot
    · omega
    · exact hnot hsub

/-- Finiteness of the Apéry set immediately gives cofiniteness of the tail
inside `H`. -/
theorem relative_compl_aperyTail_finite
    {Gamma H : AddSubmonoid ℕ} {m : ℕ}
    (hmpos : 0 < m) (hmGamma : m ∈ Gamma) (hHGamma : H ≤ Gamma)
    (hgen : IsGeneratedOver Gamma H m) (hfinite : (aperySet Gamma m).Finite) :
    Set.Finite {w : ℕ | w ∈ H ∧ w ∉ aperyTail Gamma H m} := by
  rw [relative_compl_aperyTail_eq_aperySet hmpos hmGamma hHGamma hgen]
  exact hfinite

/-- The auxiliary monoid generated by the last three displayed generators. -/
def generatedThree (n₁ n₂ n₃ : ℕ) : AddSubmonoid ℕ :=
  AddSubmonoid.closure ({n₁, n₂, n₃} : Set ℕ)

/-- The monoid generated by all four displayed generators. -/
def generatedFour (m n₁ n₂ n₃ : ℕ) : AddSubmonoid ℕ :=
  AddSubmonoid.closure ({m, n₁, n₂, n₃} : Set ℕ)

theorem generatedThree_le_generatedFour (m n₁ n₂ n₃ : ℕ) :
    generatedThree n₁ n₂ n₃ ≤ generatedFour m n₁ n₂ n₃ := by
  apply AddSubmonoid.closure_mono
  simp [generatedThree, generatedFour]

theorem firstGenerator_mem_generatedFour (m n₁ n₂ n₃ : ℕ) :
    m ∈ generatedFour m n₁ n₂ n₃ :=
  AddSubmonoid.subset_closure (by simp [generatedFour])

/-- A four-generator presentation supplies the decomposition
`w = q*m + h`, `h ∈ H`, used in the paper. -/
theorem generatedFour_isGeneratedOver (m n₁ n₂ n₃ : ℕ) :
    IsGeneratedOver (generatedFour m n₁ n₂ n₃)
      (generatedThree n₁ n₂ n₃) m := by
  intro w hw
  change w ∈ AddSubmonoid.closure ({m, n₁, n₂, n₃} : Set ℕ) at hw
  induction hw using AddSubmonoid.closure_induction with
  | mem x hx =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with hx | hx | hx | hx
      · subst x
        exact ⟨1, 0, AddSubmonoid.zero_mem _, by simp⟩
      · subst x
        exact ⟨0, n₁, AddSubmonoid.subset_closure (by simp), by simp⟩
      · subst x
        exact ⟨0, n₂, AddSubmonoid.subset_closure (by simp), by simp⟩
      · subst x
        exact ⟨0, n₃, AddSubmonoid.subset_closure (by simp), by simp⟩
  | zero => exact ⟨0, 0, AddSubmonoid.zero_mem _, by simp⟩
  | add a b ha hb iha ihb =>
      obtain ⟨qa, xa, hxa, rfl⟩ := iha
      obtain ⟨qb, xb, hxb, rfl⟩ := ihb
      exact ⟨qa + qb, xa + xb, AddSubmonoid.add_mem _ hxa hxb, by ring⟩

/-- The Apéry set of a numerical semigroup is finite.  This weaker
cardinality-free form is all the cofinite-tail argument needs. -/
theorem aperySet_finite (Gamma : NumericalSemigroup) (m : ℕ) :
    (aperySet Gamma.toAddSubmonoid m).Finite := by
  obtain ⟨c, hc⟩ := Gamma.exists_conductor
  apply (Set.finite_lt_nat (c + m)).subset
  intro w hw
  simp only [Set.mem_ofPred_eq]
  rcases hw with ⟨-, hlt | hgap⟩
  · omega
  · by_contra hnotlt
    apply hgap
    apply hc
    omega

/-- Concrete version of the Apéry-tail identity for a displayed
four-generator numerical semigroup. -/
theorem fourGenerated_relative_compl_aperyTail_eq
    (Gamma : NumericalSemigroup) (m n₁ n₂ n₃ : ℕ) (hmpos : 0 < m)
    (hGamma : Gamma.toAddSubmonoid = generatedFour m n₁ n₂ n₃) :
    {w : ℕ | w ∈ generatedThree n₁ n₂ n₃ ∧
      w ∉ aperyTail Gamma.toAddSubmonoid (generatedThree n₁ n₂ n₃) m} =
      aperySet Gamma.toAddSubmonoid m := by
  rw [hGamma]
  exact relative_compl_aperyTail_eq_aperySet hmpos
    (firstGenerator_mem_generatedFour m n₁ n₂ n₃)
    (generatedThree_le_generatedFour m n₁ n₂ n₃)
    (generatedFour_isGeneratedOver m n₁ n₂ n₃)

/-- Consequently the concrete Apéry tail is cofinite inside the auxiliary
three-generated monoid. -/
theorem fourGenerated_relative_compl_aperyTail_finite
    (Gamma : NumericalSemigroup) (m n₁ n₂ n₃ : ℕ) (hmpos : 0 < m)
    (hGamma : Gamma.toAddSubmonoid = generatedFour m n₁ n₂ n₃) :
    Set.Finite {w : ℕ | w ∈ generatedThree n₁ n₂ n₃ ∧
      w ∉ aperyTail Gamma.toAddSubmonoid (generatedThree n₁ n₂ n₃) m} := by
  rw [fourGenerated_relative_compl_aperyTail_eq Gamma m n₁ n₂ n₃ hmpos hGamma]
  exact aperySet_finite Gamma m

/-- Membership in a natural additive submonoid after embedding into `ℤ`. -/
def IntMem (S : AddSubmonoid ℕ) (z : ℤ) : Prop :=
  ∃ a : ℕ, a ∈ S ∧ z = a

/-- Integer-valued pseudo-Frobenius condition for an additive submonoid of
`ℕ`.  For numerical semigroups the resulting elements are automatically
ordinary nonnegative gaps. -/
def IsPseudoFrobeniusInt (Gamma : AddSubmonoid ℕ) (f : ℤ) : Prop :=
  ¬IntMem Gamma f ∧
    ∀ g : ℕ, g ∈ Gamma → g ≠ 0 → IntMem Gamma (f + g)

/-- The socle of the Apéry tail inside the auxiliary monoid `H`. -/
def IsSocle (Gamma H : AddSubmonoid ℕ) (m w : ℕ) : Prop :=
  w ∈ H ∧ w ∉ aperyTail Gamma H m ∧
    ∀ h : ℕ, h ∈ H → h ≠ 0 → w + h ∈ aperyTail Gamma H m

@[simp] theorem intMem_natCast_iff (S : AddSubmonoid ℕ) (a : ℕ) :
    IntMem S (a : ℤ) ↔ a ∈ S := by
  constructor
  · rintro ⟨b, hb, hab⟩
    have : a = b := by exact_mod_cast hab
    simpa [this] using hb
  · intro ha
    exact ⟨a, ha, rfl⟩

/-- The pointwise socle--pseudo-Frobenius correspondence underlying the
four-generated reduction. -/
theorem isSocle_iff_isPseudoFrobeniusInt
    {Gamma H : AddSubmonoid ℕ} {m w : ℕ}
    (hmpos : 0 < m) (hmGamma : m ∈ Gamma) (hHGamma : H ≤ Gamma)
    (hgen : IsGeneratedOver Gamma H m) :
    IsSocle Gamma H m w ↔ IsPseudoFrobeniusInt Gamma ((w : ℤ) - m) := by
  constructor
  · rintro ⟨hwH, hwNotTail, hsoc⟩
    constructor
    · rintro ⟨a, ha, heq⟩
      have hmw : m ≤ w := by
        have ha0 : (0 : ℤ) ≤ (a : ℤ) := Int.natCast_nonneg a
        omega
      apply hwNotTail
      refine ⟨hwH, hmw, ?_⟩
      have hcast : ((w - m : ℕ) : ℤ) = (w : ℤ) - m := by
        rw [Nat.cast_sub hmw]
      have haw : a = w - m := by
        exact_mod_cast (heq.symm.trans hcast.symm)
      simpa [haw] using ha
    · intro g hgGamma hgzero
      obtain ⟨q, h, hhH, hg⟩ := hgen g hgGamma
      by_cases hq : q = 0
      · subst q
        have hhzero : h ≠ 0 := by simpa [hg] using hgzero
        have htail := hsoc h hhH hhzero
        rcases htail with ⟨-, hmwh, hsub⟩
        refine ⟨w + h - m, hsub, ?_⟩
        have hcast : ((w + h - m : ℕ) : ℤ) = (w + h : ℤ) - m := by
          rw [Nat.cast_sub hmwh]
          push_cast
          rfl
        rw [hg]
        simp only [zero_mul, zero_add]
        omega
      · have hqpos : 1 ≤ q := Nat.one_le_iff_ne_zero.2 hq
        let a := w + (q - 1) * m + h
        have haGamma : a ∈ Gamma := by
          have hwGamma := hHGamma hwH
          have hmul := Gamma.nsmul_mem hmGamma (q - 1)
          have hsum := Gamma.add_mem hwGamma hmul
          exact Gamma.add_mem hsum (hHGamma hhH)
        refine ⟨a, haGamma, ?_⟩
        have hqsplit : q * m = (q - 1) * m + m := by
          calc
            q * m = ((q - 1) + 1) * m := by rw [Nat.sub_add_cancel hqpos]
            _ = (q - 1) * m + m := by simp [Nat.add_mul]
        simp only [a]
        rw [hg, hqsplit]
        push_cast
        ring
  · intro hpf
    have hmzero : m ≠ 0 := Nat.ne_of_gt hmpos
    obtain ⟨a, haGamma, haeq⟩ := hpf.2 m hmGamma hmzero
    have haweq : a = w := by
      exact_mod_cast (by omega : (a : ℤ) = w)
    subst a
    have hwGamma : w ∈ Gamma := haGamma
    have hwApery : w ∈ aperySet Gamma m := by
      refine ⟨hwGamma, ?_⟩
      by_cases hwm : w < m
      · exact Or.inl hwm
      · right
        intro hsub
        apply hpf.1
        refine ⟨w - m, hsub, ?_⟩
        rw [Nat.cast_sub (by omega : m ≤ w)]
    have hcompl : w ∈ {x : ℕ | x ∈ H ∧ x ∉ aperyTail Gamma H m} := by
      rw [relative_compl_aperyTail_eq_aperySet hmpos hmGamma hHGamma hgen]
      exact hwApery
    rcases hcompl with ⟨hwH, hwNotTail⟩
    refine ⟨hwH, hwNotTail, ?_⟩
    intro h hhH hhzero
    have hhGamma := hHGamma hhH
    obtain ⟨b, hbGamma, hbeq⟩ := hpf.2 h hhGamma hhzero
    refine ⟨H.add_mem hwH hhH, ?_, ?_⟩
    · have hb0 : (0 : ℤ) ≤ (b : ℤ) := Int.natCast_nonneg b
      omega
    · have hmwh : m ≤ w + h := by
        have hb0 : (0 : ℤ) ≤ (b : ℤ) := Int.natCast_nonneg b
        omega
      have hcast : ((w + h - m : ℕ) : ℤ) = (w + h : ℤ) - m := by
        rw [Nat.cast_sub hmwh]
        push_cast
        rfl
      have hbw : b = w + h - m := by
        exact_mod_cast (hbeq.symm.trans (by omega : (w : ℤ) - m + h =
          (w + h : ℤ) - m)).trans hcast.symm
      simpa [hbw] using hbGamma

/-- Reflection by `m` gives the paper's socle--pseudo-Frobenius bijection. -/
noncomputable def socleEquivPseudoFrobeniusInt
    {Gamma H : AddSubmonoid ℕ} {m : ℕ}
    (hmpos : 0 < m) (hmGamma : m ∈ Gamma) (hHGamma : H ≤ Gamma)
    (hgen : IsGeneratedOver Gamma H m) :
    {w // IsSocle Gamma H m w} ≃ {f // IsPseudoFrobeniusInt Gamma f} := by
  let F : {w // IsSocle Gamma H m w} → {f // IsPseudoFrobeniusInt Gamma f} :=
    fun w ↦ ⟨(w : ℕ) - (m : ℤ),
      (isSocle_iff_isPseudoFrobeniusInt hmpos hmGamma hHGamma hgen).1 w.property⟩
  have hinj : Function.Injective F := by
    intro w v hwv
    apply Subtype.ext
    have heq := congrArg (fun f : {f // IsPseudoFrobeniusInt Gamma f} ↦ (f : ℤ)) hwv
    dsimp [F] at heq
    omega
  have hsurj : Function.Surjective F := by
    intro f
    have hmzero : m ≠ 0 := Nat.ne_of_gt hmpos
    obtain ⟨w, hwGamma, hfw⟩ := f.property.2 m hmGamma hmzero
    have heq : (f : ℤ) = (w : ℤ) - m := by omega
    have hsoc : IsSocle Gamma H m w :=
      (isSocle_iff_isPseudoFrobeniusInt hmpos hmGamma hHGamma hgen).2 (by
        rw [← heq]
        exact f.property)
    refine ⟨⟨w, hsoc⟩, ?_⟩
    apply Subtype.ext
    exact heq.symm
  exact Equiv.ofBijective F ⟨hinj, hsurj⟩

/-- Cardinal form of the socle--pseudo-Frobenius correspondence. -/
theorem natCard_socle_eq_pseudoFrobeniusInt
    {Gamma H : AddSubmonoid ℕ} {m : ℕ}
    (hmpos : 0 < m) (hmGamma : m ∈ Gamma) (hHGamma : H ≤ Gamma)
    (hgen : IsGeneratedOver Gamma H m) :
    Nat.card {w // IsSocle Gamma H m w} =
      Nat.card {f // IsPseudoFrobeniusInt Gamma f} :=
  Nat.card_congr (socleEquivPseudoFrobeniusInt hmpos hmGamma hHGamma hgen)

/-- The integer pseudo-Frobenius predicate agrees definitionally with the
relative-ideal predicate for a numerical semigroup embedded in `ℤ`. -/
theorem isPseudoFrobeniusInt_iff_relativeIdeal
    (Gamma : NumericalSemigroup) (f : ℤ) :
    IsPseudoFrobeniusInt Gamma.toAddSubmonoid f ↔
      Gamma.asRelativeIdeal.IsPseudoFrobenius f := Iff.rfl

/-- Hence the cardinal of the integer pseudo-Frobenius subtype is the usual
relative-ideal type of the numerical semigroup. -/
theorem natCard_pseudoFrobeniusInt_eq_idealType (Gamma : NumericalSemigroup) :
    Nat.card {f // IsPseudoFrobeniusInt Gamma.toAddSubmonoid f} =
      Gamma.asRelativeIdeal.idealType := by
  rfl

/-- Concrete cardinal identity `t(Gamma) = |Soc(H,K_Gamma)|` for a displayed
four-generator numerical semigroup. -/
theorem fourGenerated_idealType_eq_natCard_socle
    (Gamma : NumericalSemigroup) (m n₁ n₂ n₃ : ℕ) (hmpos : 0 < m)
    (hGamma : Gamma.toAddSubmonoid = generatedFour m n₁ n₂ n₃) :
    Gamma.asRelativeIdeal.idealType =
      Nat.card {w // IsSocle Gamma.toAddSubmonoid
        (generatedThree n₁ n₂ n₃) m w} := by
  have hmGamma : m ∈ Gamma.toAddSubmonoid := by
    rw [hGamma]
    exact firstGenerator_mem_generatedFour m n₁ n₂ n₃
  have hHGamma : generatedThree n₁ n₂ n₃ ≤ Gamma.toAddSubmonoid := by
    rw [hGamma]
    exact generatedThree_le_generatedFour m n₁ n₂ n₃
  have hgen : IsGeneratedOver Gamma.toAddSubmonoid
      (generatedThree n₁ n₂ n₃) m := by
    rw [hGamma]
    exact generatedFour_isGeneratedOver m n₁ n₂ n₃
  rw [← natCard_pseudoFrobeniusInt_eq_idealType Gamma]
  exact (natCard_socle_eq_pseudoFrobeniusInt hmpos hmGamma hHGamma hgen).symm

/-- For the displayed auxiliary three-generator monoid, the socle condition
only needs to be checked on the three generators. -/
theorem isSocle_generatedThree_iff
    {Gamma : AddSubmonoid ℕ} {m n₁ n₂ n₃ w : ℕ}
    (hHGamma : generatedThree n₁ n₂ n₃ ≤ Gamma)
    (hn₁ : n₁ ≠ 0) (hn₂ : n₂ ≠ 0) (hn₃ : n₃ ≠ 0) :
    IsSocle Gamma (generatedThree n₁ n₂ n₃) m w ↔
      w ∈ generatedThree n₁ n₂ n₃ ∧
      w ∉ aperyTail Gamma (generatedThree n₁ n₂ n₃) m ∧
      w + n₁ ∈ aperyTail Gamma (generatedThree n₁ n₂ n₃) m ∧
      w + n₂ ∈ aperyTail Gamma (generatedThree n₁ n₂ n₃) m ∧
      w + n₃ ∈ aperyTail Gamma (generatedThree n₁ n₂ n₃) m := by
  let H := generatedThree n₁ n₂ n₃
  have hn₁H : n₁ ∈ H := AddSubmonoid.subset_closure (by simp [H, generatedThree])
  have hn₂H : n₂ ∈ H := AddSubmonoid.subset_closure (by simp [H, generatedThree])
  have hn₃H : n₃ ∈ H := AddSubmonoid.subset_closure (by simp [H, generatedThree])
  constructor
  · rintro ⟨hwH, hwNot, hsoc⟩
    exact ⟨hwH, hwNot, hsoc n₁ hn₁H hn₁, hsoc n₂ hn₂H hn₂,
      hsoc n₃ hn₃H hn₃⟩
  · rintro ⟨hwH, hwNot, h₁, h₂, h₃⟩
    refine ⟨hwH, hwNot, ?_⟩
    intro h hhH hhzero
    change h ∈ AddSubmonoid.closure ({n₁, n₂, n₃} : Set ℕ) at hhH
    have hind : h = 0 ∨ w + h ∈ aperyTail Gamma H m := by
      induction hhH using AddSubmonoid.closure_induction with
      | mem x hx =>
          simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
          rcases hx with rfl | rfl | rfl
          · exact Or.inr h₁
          · exact Or.inr h₂
          · exact Or.inr h₃
      | zero => exact Or.inl rfl
      | add a b ha hb iha ihb =>
          by_cases hazero : a = 0
          · subst a
            by_cases hbzero : b = 0
            · subst b
              exact Or.inl rfl
            · simpa using ihb hbzero
          · right
            have haTail := (iha hazero).resolve_left hazero
            have hbH : b ∈ H := hb
            have hadd := aperyTail_add_mem hHGamma haTail hbH
            convert hadd using 1 <;> omega
    exact hind.resolve_left hhzero

/-- Socle elements of an integral relative ideal: these are
pseudo-Frobenius elements with the additional requirement of lying in the
ambient numerical semigroup. -/
def IsIntegralSocle {H : NumericalSemigroup} (I : RelativeIdeal H) (w : ℤ) : Prop :=
  w ∈ H.asRelativeIdeal ∧ w ∉ I ∧
    ∀ h : ℕ, h ∈ H → h ≠ 0 → w + h ∈ I

/-- Forgetting ambient-semigroup membership sends every integral socle
element to a pseudo-Frobenius element. -/
theorem isIntegralSocle_isPseudoFrobenius
    {H : NumericalSemigroup} (I : RelativeIdeal H) {w : ℤ}
    (hw : IsIntegralSocle I w) : I.IsPseudoFrobenius w :=
  ⟨hw.2.1, hw.2.2⟩

/-- Under a positive three-generator presentation, the pseudo-Frobenius
subtype is finite. -/
theorem finite_pseudoFrobenius_of_generatedByThree
    {H : NumericalSemigroup} (I : RelativeIdeal H) (a b c : ℕ) [NeZero a]
    (hgen : H.IsGeneratedByThree a b c) :
    Finite {f // I.IsPseudoFrobenius f} := by
  let F : {f // I.IsPseudoFrobenius f} → ZMod a := fun f ↦ (f + a : ZMod a)
  have hinj : Function.Injective F := by
    intro f g hfg
    apply Subtype.ext
    have hf := I.aperyRepresentative_sub_modulus_eq_of_isPseudoFrobenius
      a b c hgen f.property
    have hg := I.aperyRepresentative_sub_modulus_eq_of_isPseudoFrobenius
      a b c hgen g.property
    have hrep : I.aperyRepresentative a (f + a : ZMod a) =
        I.aperyRepresentative a (g + a : ZMod a) := by
      dsimp [F] at hfg
      rw [hfg]
    omega
  exact Finite.of_injective F hinj

/-- The normalized integral socle has cardinality at most the type of the
relative ideal. -/
theorem natCard_integralSocle_le_idealType
    {H : NumericalSemigroup} (I : RelativeIdeal H) (a b c : ℕ) [NeZero a]
    (hgen : H.IsGeneratedByThree a b c) :
    Nat.card {w // IsIntegralSocle I w} ≤ I.idealType := by
  letI : Finite {f // I.IsPseudoFrobenius f} :=
    finite_pseudoFrobenius_of_generatedByThree I a b c hgen
  let F : {w // IsIntegralSocle I w} → {f // I.IsPseudoFrobenius f} :=
    fun w ↦ ⟨w, isIntegralSocle_isPseudoFrobenius I w.property⟩
  have hinj : Function.Injective F := by
    intro w v hwv
    apply Subtype.ext
    exact congrArg (fun f : {f // I.IsPseudoFrobenius f} ↦ (f : ℤ)) hwv
  exact Nat.card_le_card_of_injective F hinj

/-- The complete numerical inequality chain after the two remaining reduction
inputs have been supplied: preservation/domination of the socle under
normalization, and the generator-count comparison with `rho`. -/
theorem fourGenerated_final_bound_of_reduction
    (Gamma : NumericalSemigroup) (m n₁ n₂ n₃ : ℕ) (hmpos : 0 < m)
    (hGamma : Gamma.toAddSubmonoid = generatedFour m n₁ n₂ n₃)
    (Hbar : NumericalSemigroup) (Kbar : RelativeIdeal Hbar)
    (a b c rho : ℕ) [NeZero a]
    (hmin : Hbar.IsMinimallyGeneratedByThree a b c)
    (hsocNormalize :
      Nat.card {w // IsSocle Gamma.toAddSubmonoid
        (generatedThree n₁ n₂ n₃) m w} ≤
      Nat.card {w // IsIntegralSocle Kbar w})
    (hmuRho : Kbar.generatorCount ≤ rho) :
    Gamma.asRelativeIdeal.idealType ≤ 2 * rho := by
  calc
    Gamma.asRelativeIdeal.idealType =
        Nat.card {w // IsSocle Gamma.toAddSubmonoid
          (generatedThree n₁ n₂ n₃) m w} :=
      fourGenerated_idealType_eq_natCard_socle Gamma m n₁ n₂ n₃ hmpos hGamma
    _ ≤ Nat.card {w // IsIntegralSocle Kbar w} := hsocNormalize
    _ ≤ Kbar.idealType :=
      natCard_integralSocle_le_idealType Kbar a b c hmin.1
    _ ≤ 2 * Kbar.generatorCount :=
      Kbar.idealType_le_two_mul_generatorCount a b c hmin
    _ ≤ 2 * rho := Nat.mul_le_mul_left 2 hmuRho

/-- Minimal generators of an `H`-ideal represented as a subset of `ℕ`. -/
def IsMinimalTailGenerator (H : AddSubmonoid ℕ) (K : Set ℕ) (x : ℕ) : Prop :=
  x ∈ K ∧ ∀ h : ℕ, h ∈ H → h ≠ 0 → x < h ∨ x - h ∉ K

/-- Minimal generator count for a natural-number `H`-ideal. -/
noncomputable def tailGeneratorCount (H : AddSubmonoid ℕ) (K : Set ℕ) : ℕ :=
  Nat.card {x // IsMinimalTailGenerator H K x}

/-- The exact data preserved by division through the common divisor of the
three auxiliary generators.  Later gcd infrastructure only has to construct
these two explicit equivalences. -/
structure NormalizationData
    (Gamma H : AddSubmonoid ℕ) (m : ℕ)
    (Hbar : NumericalSemigroup) (Kbar : RelativeIdeal Hbar) where
  socleEquiv :
    {w // IsSocle Gamma H m w} ≃ {w // IsIntegralSocle Kbar w}
  generatorEquiv :
    {x // IsMinimalTailGenerator H (aperyTail Gamma H m) x} ≃
      {x // Kbar.IsMinimalGenerator x}

theorem NormalizationData.socle_natCard_eq
    {Gamma H : AddSubmonoid ℕ} {m : ℕ}
    {Hbar : NumericalSemigroup} {Kbar : RelativeIdeal Hbar}
    (D : NormalizationData Gamma H m Hbar Kbar) :
    Nat.card {w // IsSocle Gamma H m w} =
      Nat.card {w // IsIntegralSocle Kbar w} :=
  Nat.card_congr D.socleEquiv

theorem NormalizationData.generatorCount_eq
    {Gamma H : AddSubmonoid ℕ} {m : ℕ}
    {Hbar : NumericalSemigroup} {Kbar : RelativeIdeal Hbar}
    (D : NormalizationData Gamma H m Hbar Kbar) :
    tailGeneratorCount H (aperyTail Gamma H m) = Kbar.generatorCount :=
  Nat.card_congr D.generatorEquiv

/-- Conditional final theorem whose only remaining mathematical input is the
commutative-algebra estimate on the Apéry-tail generator count.  All
normalization and semigroup-theoretic steps are consumed through explicit
equivalences rather than untracked cardinal assumptions. -/
theorem fourGenerated_final_bound_of_normalization
    (Gamma : NumericalSemigroup) (m n₁ n₂ n₃ : ℕ) (hmpos : 0 < m)
    (hGamma : Gamma.toAddSubmonoid = generatedFour m n₁ n₂ n₃)
    (Hbar : NumericalSemigroup) (Kbar : RelativeIdeal Hbar)
    (a b c rho : ℕ) [NeZero a]
    (hmin : Hbar.IsMinimallyGeneratedByThree a b c)
    (D : NormalizationData Gamma.toAddSubmonoid
      (generatedThree n₁ n₂ n₃) m Hbar Kbar)
    (hmuTailRho : tailGeneratorCount (generatedThree n₁ n₂ n₃)
      (aperyTail Gamma.toAddSubmonoid (generatedThree n₁ n₂ n₃) m) ≤ rho) :
    Gamma.asRelativeIdeal.idealType ≤ 2 * rho := by
  apply fourGenerated_final_bound_of_reduction Gamma m n₁ n₂ n₃ hmpos hGamma
    Hbar Kbar a b c rho hmin
  · exact D.socle_natCard_eq.le
  · rw [← D.generatorCount_eq]
    exact hmuTailRho

