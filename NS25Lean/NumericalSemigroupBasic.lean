import Mathlib.Algebra.Group.Submonoid.Basic
import Mathlib.Algebra.Group.Nat.Defs
import Mathlib.Data.Set.Finite.Basic
import Mathlib.Data.Set.Finite.Lattice

set_option linter.style.header false

/-!
# Minimal numerical-semigroup infrastructure for NS25

The project only needs an additive submonoid of `ℕ` with finite complement.
This intentionally avoids a larger commutative-algebra interface.
-/

namespace NS25Lean

/-- A numerical semigroup is an additive submonoid of `ℕ` with finite complement. -/
structure NumericalSemigroup where
  toAddSubmonoid : AddSubmonoid ℕ
  finite_compl : Set.Finite {n : ℕ | n ∉ toAddSubmonoid}

namespace NumericalSemigroup

instance : Membership ℕ NumericalSemigroup :=
  ⟨fun H n => n ∈ H.toAddSubmonoid⟩

@[simp] theorem mem_toAddSubmonoid {H : NumericalSemigroup} {n : ℕ} :
    n ∈ H.toAddSubmonoid ↔ n ∈ H := Iff.rfl

@[simp] theorem zero_mem (H : NumericalSemigroup) : 0 ∈ H :=
  H.toAddSubmonoid.zero_mem

theorem add_mem (H : NumericalSemigroup) {m n : ℕ} (hm : m ∈ H) (hn : n ∈ H) :
    m + n ∈ H :=
  H.toAddSubmonoid.add_mem hm hn

/-- The exceptional natural numbers outside a numerical semigroup. -/
def gaps (H : NumericalSemigroup) : Set ℕ := {n | n ∉ H}

theorem gaps_finite (H : NumericalSemigroup) : H.gaps.Finite :=
  H.finite_compl

/-- Every sufficiently large natural number belongs to a numerical semigroup. -/
theorem exists_conductor (H : NumericalSemigroup) :
    ∃ conductor : ℕ, ∀ n : ℕ, conductor ≤ n → n ∈ H := by
  obtain ⟨bound, hbound⟩ := H.gaps_finite.bddAbove
  refine ⟨bound + 1, fun n hn ↦ ?_⟩
  by_contra hnot
  have hle : n ≤ bound := hbound hnot
  omega

/-- The additive submonoid generated by a set of natural numbers. -/
def generatedBy (s : Set ℕ) : AddSubmonoid ℕ := AddSubmonoid.closure s

/-- A concrete three-element generating presentation. -/
def IsGeneratedByThree (H : NumericalSemigroup) (a b c : ℕ) : Prop :=
  H.toAddSubmonoid = generatedBy {a, b, c}

/-- Membership in a displayed three-generator presentation. -/
theorem mem_generatedByThree_iff {H : NumericalSemigroup} {a b c h : ℕ}
    (hgen : H.IsGeneratedByThree a b c) :
    h ∈ H ↔ h ∈ AddSubmonoid.closure {a, b, c} := by
  rw [← mem_toAddSubmonoid, hgen]
  rfl

/-- None of the three displayed generators is generated by the other two. -/
def IsMinimallyGeneratedByThree (H : NumericalSemigroup) (a b c : ℕ) : Prop :=
  H.IsGeneratedByThree a b c ∧
    a ∉ generatedBy {b, c} ∧
    b ∉ generatedBy {a, c} ∧
    c ∉ generatedBy {a, b}

end NumericalSemigroup
end NS25Lean
