import NS25Lean.P2SectorB
import NS25Lean.TailIdealNormalization
import NS25Lean.AperyConstruction

set_option linter.style.header false

noncomputable section
namespace NS25Lean.L5A2B2

open FourGeneratedBridge CombinatorialCore
open ChosenBase

variable {Gamma : NumericalSemigroup}

/-- The chosen pivot order is an actual minimally generated displayed four-tuple. -/
theorem chosenBase_minimalFour (B : Data Gamma) :
    IsMinimallyGeneratedByFour Gamma B.q.val
      (B.tailDegrees 0).val (B.tailDegrees 1).val (B.tailDegrees 2).val := by
  change IsMinimallyGeneratedByFour Gamma (B.degrees 0).val
    (B.degrees 1).val (B.degrees 2).val (B.degrees 3).val
  have hall : Set.range (fun i => (B.degrees i).val) =
      ({(B.degrees 0).val, (B.degrees 1).val,
        (B.degrees 2).val, (B.degrees 3).val} : Set ℕ) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      fin_cases i <;> simp
    · intro hx
      rcases hx with hx | hx | hx | hx
      · exact ⟨0, hx.symm⟩
      · exact ⟨1, hx.symm⟩
      · exact ⟨2, hx.symm⟩
      · exact ⟨3, hx.symm⟩
  have hset0 : ((fun j => (B.degrees j).val) '' {j | j ≠ (0 : Fin 4)}) =
      ({(B.degrees 1).val, (B.degrees 2).val, (B.degrees 3).val} : Set ℕ) := by
    ext x
    constructor
    · rintro ⟨j, hj, rfl⟩
      fin_cases j <;> simp_all
    · intro hx
      rcases hx with hx | hx | hx
      · exact ⟨1, by decide, hx.symm⟩
      · exact ⟨2, by decide, hx.symm⟩
      · exact ⟨3, by decide, hx.symm⟩
  have hset1 : ((fun j => (B.degrees j).val) '' {j | j ≠ (1 : Fin 4)}) =
      ({(B.degrees 0).val, (B.degrees 2).val, (B.degrees 3).val} : Set ℕ) := by
    ext x
    constructor
    · rintro ⟨j, hj, rfl⟩
      fin_cases j <;> simp_all
    · intro hx
      rcases hx with hx | hx | hx
      · exact ⟨0, by decide, hx.symm⟩
      · exact ⟨2, by decide, hx.symm⟩
      · exact ⟨3, by decide, hx.symm⟩
  have hset2 : ((fun j => (B.degrees j).val) '' {j | j ≠ (2 : Fin 4)}) =
      ({(B.degrees 0).val, (B.degrees 1).val, (B.degrees 3).val} : Set ℕ) := by
    ext x
    constructor
    · rintro ⟨j, hj, rfl⟩
      fin_cases j <;> simp_all
    · intro hx
      rcases hx with hx | hx | hx
      · exact ⟨0, by decide, hx.symm⟩
      · exact ⟨1, by decide, hx.symm⟩
      · exact ⟨3, by decide, hx.symm⟩
  have hset3 : ((fun j => (B.degrees j).val) '' {j | j ≠ (3 : Fin 4)}) =
      ({(B.degrees 0).val, (B.degrees 1).val, (B.degrees 2).val} : Set ℕ) := by
    ext x
    constructor
    · rintro ⟨j, hj, rfl⟩
      fin_cases j <;> simp_all
    · intro hx
      rcases hx with hx | hx | hx
      · exact ⟨0, by decide, hx.symm⟩
      · exact ⟨1, by decide, hx.symm⟩
      · exact ⟨2, by decide, hx.symm⟩
  constructor
  · rw [generatedFour, ← hall, B.degrees_generate_nat]
  · exact B.degrees_positive 0
  · exact B.degrees_positive 1
  · exact B.degrees_positive 2
  · exact B.degrees_positive 3
  · simpa [generatedThree, hset0] using B.degrees_minimal 0
  · simpa [generatedThree, hset1] using B.degrees_minimal 1
  · simpa [generatedThree, hset2] using B.degrees_minimal 2
  · simpa [generatedThree, hset3] using B.degrees_minimal 3

/-- The displayed tail monoid is exactly the monoid generated by the three
tail entries in pivot order. -/
theorem chosenBase_tail_eq_generatedThree (B : Data Gamma) :
    B.H = generatedThree (B.tailDegrees 0).val
      (B.tailDegrees 1).val (B.tailDegrees 2).val := by
  change AddSubmonoid.closure
      (Set.range (fun j : Fin 3 => (B.degrees j.succ).val)) = _
  rw [generatedThree]
  congr 1
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    fin_cases i <;> simp [Data.tailDegrees]
  · intro hx
    rcases hx with hx | hx | hx
    · exact ⟨0, by simpa [Data.tailDegrees] using hx.symm⟩
    · exact ⟨1, by simpa [Data.tailDegrees] using hx.symm⟩
    · exact ⟨2, by simpa [Data.tailDegrees] using hx.symm⟩

/-- The actual normalized Apéry-tail routing graph attached to a chosen base.
Its sources are the chosen tail sources, its sinks are the normalized tail
type, and both exact edge-count identities hold. -/
theorem exists_actualRouting_checkpoint (B : Data Gamma) :
    let n₁ := (B.tailDegrees 0).val
    let n₂ := (B.tailDegrees 1).val
    let n₃ := (B.tailDegrees 2).val
    let h4 := chosenBase_minimalFour B
    let a := n₁ / tailGcd n₁ n₂ n₃
    let I := normalizedTailIdeal Gamma B.q.val n₁ n₂ n₃ h4
    ∃ ha : 0 < a,
      letI : NeZero a := ⟨Nat.ne_of_gt ha⟩
      ∃ D : ResidueData (ZMod a),
        D.sourceCount = L2B.sourceCount B ∧
        D.sinkCount = I.idealType ∧
        D.edgeCount + D.sinkCount = Fintype.card (ZMod a) + D.branchCount ∧
        D.edgeCount + D.sourceCount = Fintype.card (ZMod a) + D.mergeCount ∧
        Gamma.asRelativeIdeal.idealType ≤ D.sinkCount ∧
        D.sinkCount + D.mergeCount = D.sourceCount + D.branchCount ∧
        D.branchCount ≤ D.sourceCount + D.mergeCount ∧
        D.sinkCount = Gamma.asRelativeIdeal.idealType +
          (D.sinkCount - Gamma.asRelativeIdeal.idealType) ∧
        (D.sinkCount : ℤ) =
          (D.sourceCount : ℤ) + (D.branchCount : ℤ) - (D.mergeCount : ℤ) := by
  dsimp only
  let n₁ := (B.tailDegrees 0).val
  let n₂ := (B.tailDegrees 1).val
  let n₃ := (B.tailDegrees 2).val
  let h4 := chosenBase_minimalFour B
  let a := n₁ / tailGcd n₁ n₂ n₃
  let b := n₂ / tailGcd n₁ n₂ n₃
  let c := n₃ / tailGcd n₁ n₂ n₃
  let Hbar := normalizedSemigroup n₁ n₂ n₃ h4.n₁_pos
  let I := normalizedTailIdeal Gamma B.q.val n₁ n₂ n₃ h4
  have ha : 0 < a := quotient_pos_of_dvd h4.n₁_pos (tailGcd_dvd n₁ n₂ n₃).1
  refine ⟨ha, ?_⟩
  letI : NeZero a := ⟨Nat.ne_of_gt ha⟩
  have hmin : Hbar.IsMinimallyGeneratedByThree a b c := normalizedSemigroup_minimal h4
  have haH : a ∈ Hbar := (NumericalSemigroup.mem_generatedByThree_iff hmin.1).2
    (AddSubmonoid.subset_closure (by simp))
  have hbH : b ∈ Hbar := (NumericalSemigroup.mem_generatedByThree_iff hmin.1).2
    (AddSubmonoid.subset_closure (by simp))
  have hcH : c ∈ Hbar := (NumericalSemigroup.mem_generatedByThree_iff hmin.1).2
    (AddSubmonoid.subset_closure (by simp))
  have hb : b ≠ 0 := by
    intro hz
    apply hmin.2.2.1
    rw [hz]
    exact AddSubmonoid.zero_mem _
  have hc : c ≠ 0 := by
    intro hz
    apply hmin.2.2.2
    rw [hz]
    exact AddSubmonoid.zero_mem _
  let step := I.toAperyStepData a b c hbH hcH
  let valid := I.toAperyStepData_isValid a b c hbH hcH
  let D := step.toResidueData valid
  have hout := D.outgoing_edge_count
  have hin := D.incoming_edge_count
  have hbalance := ResidueData.edge_count_balance hout hin
  have htype : Gamma.asRelativeIdeal.idealType ≤ D.sinkCount := by
    rw [I.concrete_sinkCount_eq_idealType a b c hmin.1 haH hbH hcH hb hc]
    exact (fourGenerated_normalization_chain Gamma B.q.val n₁ n₂ n₃ h4).1
  refine ⟨D, ?_, ?_, hout, hin, htype, hbalance,
    D.branchCount_le_sourceCount_add_mergeCount, Nat.add_sub_of_le htype |>.symm, ?_⟩
  · calc
      D.sourceCount = I.generatorCount :=
        I.concrete_sourceCount_eq_generatorCount a b c hmin.1 hbH hcH hb hc
      _ = tailGeneratorCount (generatedThree n₁ n₂ n₃)
          (aperyTail Gamma.toAddSubmonoid (generatedThree n₁ n₂ n₃) B.q.val) :=
        normalizedTail_generatorCount Gamma B.q.val n₁ n₂ n₃ h4
      _ = L2B.sourceCount B := by
        rw [L2B.sourceCount, Data.K, chosenBase_tail_eq_generatedThree B]
  · exact I.concrete_sinkCount_eq_idealType a b c hmin.1 haH hbH hcH hb hc
  · have hi : (D.sinkCount : ℤ) + (D.mergeCount : ℤ) =
        (D.sourceCount : ℤ) + (D.branchCount : ℤ) := by
      exact_mod_cast hbalance
    omega

end NS25Lean.L5A2B2
