import NS25Lean.P2SectorCActualRoleGateR19

set_option linter.style.header false
noncomputable section

namespace NS25Lean.L5A2C4OR19

open FourGeneratedBridge L5A2C4H L5A2C4OR1 L5A2C4OR3

/-- The actual positive-return cut, with a natural-number H-representation. -/
def cyclicCut (H : NumericalSemigroup) (m : ℕ) : Set ℕ :=
  {x | x ∈ H ∧ ∃ n : ℕ, 0 < n ∧ ∃ h : ℕ, h ∈ H ∧ x = n * m + h}

private theorem exists_positive_principal (H : NumericalSemigroup)
    (m : ℕ) (hm : 0 < m) : ∃ n : ℕ, 0 < n ∧ n * m ∈ H := by
  obtain ⟨c, hc⟩ := H.exists_conductor
  refine ⟨c + 1, by omega, hc _ ?_⟩
  nlinarith

/-- Least positive index whose principal degree lies in H; existence is
derived from cofiniteness, never stored as a counting hypothesis. -/
def firstPrincipal (H : NumericalSemigroup) (m : ℕ) (hm : 0 < m) : ℕ := by
  classical
  exact Nat.find (exists_positive_principal H m hm)

theorem firstPrincipal_spec (H : NumericalSemigroup) (m : ℕ) (hm : 0 < m) :
    0 < firstPrincipal H m hm ∧ firstPrincipal H m hm * m ∈ H := by
  classical
  exact Nat.find_spec (exists_positive_principal H m hm)

theorem firstPrincipal_le (H : NumericalSemigroup) (m : ℕ) (hm : 0 < m)
    {n : ℕ} (hn : 0 < n) (hmem : n * m ∈ H) :
    firstPrincipal H m hm ≤ n := by
  classical
  exact Nat.find_min' (exists_positive_principal H m hm) ⟨hn, hmem⟩

/-- T1: the first positive principal is a genuine H-minimal cut source,
even when its canonical monomial has zero exponents. -/
theorem firstPrincipal_minimal_cut_source
    (H : NumericalSemigroup) (m : ℕ) (hm : 0 < m) :
    IsMinimalTailGenerator H.toAddSubmonoid (cyclicCut H m)
      (firstPrincipal H m hm * m) := by
  let q := firstPrincipal H m hm
  change IsMinimalTailGenerator H.toAddSubmonoid (cyclicCut H m) (q * m)
  have hq : 0 < q ∧ q * m ∈ H := firstPrincipal_spec H m hm
  refine ⟨⟨hq.2, q, hq.1, 0, H.toAddSubmonoid.zero_mem, by simp⟩, ?_⟩
  intro g hg hg0
  by_cases hlt : q * m < g
  · exact Or.inl hlt
  · right
    rintro ⟨_, n, hn, h, hh, heq⟩
    have hgpos : 0 < g := Nat.pos_of_ne_zero hg0
    have hgle : g ≤ q * m := by omega
    have hnlt : n < q := by
      by_contra hnq
      have hmul := Nat.mul_le_mul_right m (show q ≤ n by omega)
      omega
    have hdiff : (q - n) * m = g + h := by
      rw [Nat.sub_mul]
      have hnm : n * m ≤ q * m := Nat.mul_le_mul_right m (by omega)
      omega
    have hreturn : (q - n) * m ∈ H := by
      rw [hdiff]
      exact H.toAddSubmonoid.add_mem hg hh
    have hmin := firstPrincipal_le H m hm (by omega : 0 < q - n) hreturn
    change q ≤ q - n at hmin
    omega

/-- T1: a return above q0 reduces to the smaller positive return n-q0,
carrying the principal degree into the H-summand. -/
theorem principal_return_reduction (H : NumericalSemigroup)
    (m : ℕ) (hm : 0 < m) {n h : ℕ}
    (hn : firstPrincipal H m hm < n) (hh : h ∈ H) :
    firstPrincipal H m hm * m + h ∈ H ∧
      n * m + h = (n - firstPrincipal H m hm) * m +
        (firstPrincipal H m hm * m + h) := by
  constructor
  · exact H.toAddSubmonoid.add_mem (firstPrincipal_spec H m hm).2 hh
  · rw [Nat.sub_mul]
    have hle := Nat.mul_le_mul_right m (Nat.le_of_lt hn)
    omega

/-- The entire infinite cut is generated by the finite range 1..q0.
This does not restrict the MAX-MIN selector to that range. -/
theorem cyclicCut_finite_principal_reduction (H : NumericalSemigroup)
    (m : ℕ) (hm : 0 < m) (x : ℕ) :
    x ∈ cyclicCut H m ↔
      x ∈ H ∧ ∃ n : ℕ, 0 < n ∧ n ≤ firstPrincipal H m hm ∧
        ∃ h : ℕ, h ∈ H ∧ x = n * m + h := by
  constructor
  · rintro ⟨hx, n, hn, h, hh, heq⟩
    have reduce : ∀ n : ℕ, 0 < n → ∀ h : ℕ, h ∈ H →
        ∃ r : ℕ, 0 < r ∧ r ≤ firstPrincipal H m hm ∧
          ∃ t : ℕ, t ∈ H ∧ n * m + h = r * m + t := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro hn h hh
        by_cases hle : n ≤ firstPrincipal H m hm
        · exact ⟨n, hn, hle, h, hh, rfl⟩
        · have hgt : firstPrincipal H m hm < n := by omega
          have hq := (firstPrincipal_spec H m hm).1
          obtain ⟨hmem, hrewrite⟩ := principal_return_reduction H m hm hgt hh
          obtain ⟨r, hr, hrle, t, ht, hrt⟩ :=
            ih (n - firstPrincipal H m hm) (by omega) (by omega) _ hmem
          exact ⟨r, hr, hrle, t, ht, hrewrite.trans hrt⟩
    obtain ⟨r, hr, hrle, t, ht, hrt⟩ := reduce n hn h hh
    exact ⟨hx, r, hr, hrle, t, ht, heq.trans hrt⟩
  · rintro ⟨hx, n, hn, _, h, hh, heq⟩
    exact ⟨hx, n, hn, h, hh, heq⟩

variable {Gamma : NumericalSemigroup}

/-- The abstract cut above is exactly the actual normalized-tail ideal,
not an arbitrary substitute ideal. -/
theorem actual_cyclicCut_iff_routingI
    (B : ChosenBase.Data Gamma) (e : Fin 3 ≃ Fin 3) (x : ℕ) :
    x ∈ cyclicCut (routingH B e) (routingM B e) ↔
      (x : ℤ) ∈ routingI B e := by
  rw [mem_routingI_iff_positive_return]
  constructor
  · rintro ⟨hx, n, hn, h, hh, heq⟩
    refine ⟨n, hn, ⟨x, hx, rfl⟩, h, hh, ?_⟩
    rw [heq]
    push_cast
    ring
  · rintro ⟨n, hn, ⟨y, hy, heqy⟩, h, hh, heqh⟩
    have hyx : y = x := by exact_mod_cast heqy.symm
    subst y
    refine ⟨hy, n, hn, h, hh, ?_⟩
    have hi : (x : ℤ) = n * routingM B e + h := by omega
    exact_mod_cast hi

