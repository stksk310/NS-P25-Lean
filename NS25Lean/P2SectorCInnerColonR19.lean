import NS25Lean.P2SectorCPreprincipalR19

set_option linter.style.header false
noncomputable section

namespace NS25Lean.L5A2C4OR19

open L5A2C4A L5A2C4C L5A2C4D L5A2C4H L5A2C4OR1 L5A2C4OR5

variable {Gamma : NumericalSemigroup}

/-- The individual positive-return ideal, not the union or an arbitrary ideal. -/
def positiveReturnPiece (H : NumericalSemigroup) (m n : ℕ) : Set ℕ :=
  {x | x ∈ H ∧ 0 < n ∧ ∃ h : ℕ, h ∈ H ∧ x = n * m + h}

/-- The four precise inner colon generator degrees in the accepted source. -/
def innerColonGenerators (B : ChosenBase.Data Gamma) (e : Fin 3 ≃ Fin 3)
    (HD : CoherentHerzogData B e) (i j d : ℕ) : Set ℕ :=
  {g | g = normalizedGrid B e 0 i j ∨
    g = normalizedGrid B e (cr31 HD - d) (i + cr32 HD) 0 ∨
    g = normalizedGrid B e (cr21 HD - d) 0 (j + cr23 HD) ∨
    g = normalizedGrid B e (c1 B e - d) 0 0}

/-- Exact H-ideal generation, expressed with actual nonnegative H-summands. -/
def hGeneratedSet (H : NumericalSemigroup) (G : Set ℕ) : Set ℕ :=
  {x | ∃ g : ℕ, g ∈ G ∧ ∃ h : ℕ, h ∈ H ∧ x = g + h}

private theorem grid_mem_H (B : ChosenBase.Data Gamma) (e : Fin 3 ≃ Fin 3)
    (n i j : ℕ) : normalizedGrid B e n i j ∈ routingH B e := by
  have ha : routingA B e ∈ routingH B e := by
    change routingA B e ∈ FourGeneratedBridge.generatedThree
      (routingA B e) (routingB B e) (routingC B e)
    exact AddSubmonoid.subset_closure (by simp)
  have hn := (routingH B e).toAddSubmonoid.nsmul_mem ha n
  have hi := (routingH B e).toAddSubmonoid.nsmul_mem (routingHB B e) i
  have hj := (routingH B e).toAddSubmonoid.nsmul_mem (routingHC B e) j
  simpa [normalizedGrid, nsmul_eq_mul, Nat.add_assoc] using
    (routingH B e).toAddSubmonoid.add_mem
      ((routingH B e).toAddSubmonoid.add_mem hn hi) hj

/-- T3 reverse inclusion: every displayed inner generator is a genuine
positive return. Each difference is constructed explicitly in H. -/
theorem innerColonGenerators_mem_returnPiece
    (B : ChosenBase.Data Gamma) (e : Fin 3 ≃ Fin 3)
    (HD : CoherentHerzogData B e) {n i j d : ℕ}
    (hn : 0 < n) (hi : i < cr12 HD) (hj : j < cr13 HD)
    (hdk : d < cr21 HD) (hdl : d < cr31 HD)
    (heq : n * routingM B e + d * routingA B e =
      i * routingB B e + j * routingC B e) :
    ∀ g ∈ innerColonGenerators B e HD i j d,
      g ∈ positiveReturnPiece (routingH B e) (routingM B e) n := by
  have hs := coherent_coefficients B e HD
  have hr := coherent_normalized_relations B e HD
  have hp := coherent_coefficients_positive B e HD
  have hiI : i ≤ c2 B e := by omega
  have hjJ : j ≤ c3 B e := by omega
  intro g hg
  rcases hg with rfl | rfl | rfl | rfl
  · refine ⟨grid_mem_H B e 0 i j, hn, normalizedGrid B e d 0 0,
      grid_mem_H B e d 0 0, ?_⟩
    simpa [normalizedGrid] using heq.symm
  · have hD := congrArg (fun z => z * routingA B e)
      (show cr31 HD - d + d = cr31 HD by omega)
    have hJ := congrArg (fun z => z * routingC B e)
      (show c3 B e - j + j = c3 B e by omega)
    simp only [Nat.add_mul] at hD hJ
    refine ⟨grid_mem_H B e _ _ _, hn, normalizedGrid B e 0 0 (c3 B e - j),
      grid_mem_H B e _ _ _, ?_⟩
    simp only [normalizedGrid, zero_mul, zero_add, add_zero, Nat.add_mul]
    nlinarith only [heq, hr.2.2, hD, hJ]
  · have hD := congrArg (fun z => z * routingA B e)
      (show cr21 HD - d + d = cr21 HD by omega)
    have hI := congrArg (fun z => z * routingB B e)
      (show c2 B e - i + i = c2 B e by omega)
    simp only [Nat.add_mul] at hD hI
    refine ⟨grid_mem_H B e _ _ _, hn, normalizedGrid B e 0 (c2 B e - i) 0,
      grid_mem_H B e _ _ _, ?_⟩
    simp only [normalizedGrid, zero_mul, zero_add, add_zero, Nat.add_mul]
    nlinarith only [heq, hr.2.1, hD, hI]
  · have hD := congrArg (fun z => z * routingA B e)
      (show c1 B e - d + d = c1 B e by omega)
    have hI := congrArg (fun z => z * routingB B e)
      (show cr12 HD - i + i = cr12 HD by omega)
    have hJ := congrArg (fun z => z * routingC B e)
      (show cr13 HD - j + j = cr13 HD by omega)
    simp only [Nat.add_mul] at hD hI hJ
    refine ⟨grid_mem_H B e _ _ _, hn,
      normalizedGrid B e 0 (cr12 HD - i) (cr13 HD - j), grid_mem_H B e _ _ _, ?_⟩
    simp only [normalizedGrid, zero_mul, zero_add, add_zero]
    nlinarith only [heq, hr.1, hD, hI, hJ]

/-- The entire H-ideal generated by the four displayed degrees lies in the
actual return piece. This is only the reverse inclusion of T3 exactness. -/
theorem inner_colon_reverse_inclusion
    (B : ChosenBase.Data Gamma) (e : Fin 3 ≃ Fin 3)
    (HD : CoherentHerzogData B e) {n i j d : ℕ}
    (hn : 0 < n) (hi : i < cr12 HD) (hj : j < cr13 HD)
    (hdk : d < cr21 HD) (hdl : d < cr31 HD)
    (heq : n * routingM B e + d * routingA B e =
      i * routingB B e + j * routingC B e) :
    hGeneratedSet (routingH B e) (innerColonGenerators B e HD i j d) ⊆
      positiveReturnPiece (routingH B e) (routingM B e) n := by
  rintro x ⟨g, hg, h, hh, rfl⟩
  obtain ⟨hgH, hn, t, ht, hgt⟩ :=
    innerColonGenerators_mem_returnPiece B e HD hn hi hj hdk hdl heq g hg
  refine ⟨(routingH B e).toAddSubmonoid.add_mem hgH hh, hn,
    t + h, (routingH B e).toAddSubmonoid.add_mem ht hh, ?_⟩
  rw [hgt]
  omega

end NS25Lean.L5A2C4OR19
