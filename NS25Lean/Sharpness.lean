import NS25Lean.CanonicalDual

set_option linter.style.header false

/-!
# A concrete sharpness example

We formalize the smallest member `H₁ = ⟨3,4,5⟩` of the sharpness family.
Its underlying set is `{0} ∪ [3,∞)`.  The regular relative ideal has one
minimal generator and two pseudo-Frobenius elements; canonical duality reverses
these two counts.
-/

namespace NS25Lean

/-- The numerical semigroup `H₁ = ⟨3,4,5⟩ = {0} ∪ [3,∞)`. -/
def sharpnessSemigroupOne : NumericalSemigroup where
  toAddSubmonoid :=
    { carrier := {n : ℕ | n = 0 ∨ 3 ≤ n}
      zero_mem' := Or.inl rfl
      add_mem' := by
        rintro m n (rfl | hm) (rfl | hn)
        · exact Or.inl rfl
        · exact Or.inr (by omega)
        · exact Or.inr (by omega)
        · exact Or.inr (by omega) }
  finite_compl := by
    have hsub : {n : ℕ | ¬(n = 0 ∨ 3 ≤ n)} ⊆ ({1, 2} : Set ℕ) := by
      intro n hn
      simp only [Set.mem_ofPred_eq, not_or, not_le] at hn
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
      omega
    exact (Set.finite_singleton 2).insert 1 |>.subset hsub

namespace sharpnessSemigroupOne

@[simp] theorem mem_iff (n : ℕ) :
    n ∈ sharpnessSemigroupOne ↔ n = 0 ∨ 3 ≤ n := Iff.rfl

private theorem three_four_five_generate_large (n : ℕ) (hn : 3 ≤ n) :
    n ∈ AddSubmonoid.closure ({3, 4, 5} : Set ℕ) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
      by_cases hsmall : n < 6
      · have hcases : n = 3 ∨ n = 4 ∨ n = 5 := by omega
        rcases hcases with rfl | rfl | rfl <;>
          exact AddSubmonoid.subset_closure (by simp)
      · have hprev : n - 3 ∈ AddSubmonoid.closure ({3, 4, 5} : Set ℕ) :=
          ih (n - 3) (by omega) (by omega)
        have hthree : 3 ∈ AddSubmonoid.closure ({3, 4, 5} : Set ℕ) :=
          AddSubmonoid.subset_closure (by simp)
        convert AddSubmonoid.add_mem _ hprev hthree using 1 <;> omega

/-- The concrete carrier really is generated by `3, 4, 5`. -/
theorem isGeneratedByThree :
    sharpnessSemigroupOne.IsGeneratedByThree 3 4 5 := by
  apply AddSubmonoid.ext
  intro n
  constructor
  · intro hn
    rcases hn with rfl | hn
    · exact AddSubmonoid.zero_mem _
    · exact three_four_five_generate_large n hn
  · intro hn
    induction hn using AddSubmonoid.closure_induction with
    | mem n hn =>
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hn
        rcases hn with rfl | rfl | rfl <;> simp [sharpnessSemigroupOne]
    | zero => exact NumericalSemigroup.zero_mem sharpnessSemigroupOne
    | add m n hm hn ihm ihn => exact NumericalSemigroup.add_mem sharpnessSemigroupOne ihm ihn

private theorem closure_four_five_ge (n : ℕ)
    (hn : n ∈ AddSubmonoid.closure ({4, 5} : Set ℕ)) : n = 0 ∨ 4 ≤ n := by
  induction hn using AddSubmonoid.closure_induction with
  | mem n hn => simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hn; omega
  | zero => exact Or.inl rfl
  | add m n hm hn ihm ihn => omega

private theorem closure_three_five_shape (n : ℕ)
    (hn : n ∈ AddSubmonoid.closure ({3, 5} : Set ℕ)) :
    n = 0 ∨ n = 3 ∨ 5 ≤ n := by
  induction hn using AddSubmonoid.closure_induction with
  | mem n hn => simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hn; omega
  | zero => exact Or.inl rfl
  | add m n hm hn ihm ihn => omega

private theorem closure_three_four_shape (n : ℕ)
    (hn : n ∈ AddSubmonoid.closure ({3, 4} : Set ℕ)) :
    n = 0 ∨ n = 3 ∨ n = 4 ∨ 6 ≤ n := by
  induction hn using AddSubmonoid.closure_induction with
  | mem n hn => simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hn; omega
  | zero => exact Or.inl rfl
  | add m n hm hn ihm ihn => omega

/-- The presentation `H₁ = ⟨3,4,5⟩` is minimal. -/
theorem isMinimallyGeneratedByThree :
    sharpnessSemigroupOne.IsMinimallyGeneratedByThree 3 4 5 := by
  refine ⟨isGeneratedByThree, ?_, ?_, ?_⟩
  · intro h
    have := closure_four_five_ge 3 h
    omega
  · intro h
    have := closure_three_five_shape 4 h
    omega
  · intro h
    have := closure_three_four_shape 5 h
    omega

end sharpnessSemigroupOne

namespace RelativeIdeal

/-- The regular relative ideal of `H₁`. -/
abbrev sharpnessIdealOne : RelativeIdeal sharpnessSemigroupOne :=
  sharpnessSemigroupOne.asRelativeIdeal

@[simp] theorem mem_sharpnessIdealOne_iff (z : ℤ) :
    z ∈ sharpnessIdealOne ↔ z = 0 ∨ 3 ≤ z := by
  constructor
  · rintro ⟨n, hn, rfl⟩
    rcases (sharpnessSemigroupOne.mem_iff n).mp hn with rfl | hn
    · exact Or.inl rfl
    · exact Or.inr (by exact_mod_cast hn)
  · intro hz
    have hnonneg : (0 : ℤ) ≤ z := by omega
    let n := z.toNat
    have hncast : (n : ℤ) = z := Int.toNat_of_nonneg hnonneg
    refine ⟨n, ?_, hncast.symm⟩
    rw [sharpnessSemigroupOne.mem_iff]
    rcases hz with rfl | hz
    · exact Or.inl (by simp [n])
    · right
      have hzcast : (3 : ℤ) ≤ (n : ℤ) := by rw [hncast]; exact hz
      exact_mod_cast hzcast

/-- The regular ideal of `H₁` has the unique minimal generator `0`. -/
theorem isMinimalGenerator_sharpnessIdealOne_iff (x : ℤ) :
    sharpnessIdealOne.IsMinimalGenerator x ↔ x = 0 := by
  constructor
  · rintro ⟨⟨n, hn, rfl⟩, hmin⟩
    by_contra hnzero
    have hnzeroNat : n ≠ 0 := by
      intro h
      apply hnzero
      simp [h]
    apply hmin n hn hnzeroNat
    simpa using (show (0 : ℤ) ∈ sharpnessIdealOne from
      ⟨0, sharpnessSemigroupOne.zero_mem, rfl⟩)
  · rintro rfl
    constructor
    · exact ⟨0, sharpnessSemigroupOne.zero_mem, rfl⟩
    · intro h hh hzero hmem
      obtain ⟨n, -, heq⟩ := hmem
      have : -(h : ℤ) = n := by simpa using heq
      omega

/-- The pseudo-Frobenius elements of the regular ideal of `H₁` are exactly
`1` and `2`. -/
theorem isPseudoFrobenius_sharpnessIdealOne_iff (f : ℤ) :
    sharpnessIdealOne.IsPseudoFrobenius f ↔ f = 1 ∨ f = 2 := by
  rw [sharpnessIdealOne.isPseudoFrobenius_iff_add_generators
    sharpnessSemigroupOne.isGeneratedByThree (by norm_num) (by norm_num) (by norm_num)]
  simp only [mem_sharpnessIdealOne_iff]
  omega

/-- The regular ideal of `H₁` has one minimal generator. -/
theorem generatorCount_sharpnessIdealOne :
    sharpnessIdealOne.generatorCount = 1 := by
  let E : {x // sharpnessIdealOne.IsMinimalGenerator x} ≃ Fin 1 :=
    { toFun := fun _ ↦ ⟨0, by omega⟩
      invFun := fun _ ↦ ⟨0, (isMinimalGenerator_sharpnessIdealOne_iff 0).2 rfl⟩
      left_inv := fun x ↦ by
        apply Subtype.ext
        exact ((isMinimalGenerator_sharpnessIdealOne_iff x).1 x.property).symm
      right_inv := fun x ↦ by
        apply Fin.ext
        omega }
  simpa [generatorCount] using Nat.card_congr E

/-- The regular ideal of `H₁` has type two. -/
theorem idealType_sharpnessIdealOne :
    sharpnessIdealOne.idealType = 2 := by
  have hpf1 : sharpnessIdealOne.IsPseudoFrobenius 1 :=
    (isPseudoFrobenius_sharpnessIdealOne_iff 1).2 (Or.inl rfl)
  have hpf2 : sharpnessIdealOne.IsPseudoFrobenius 2 :=
    (isPseudoFrobenius_sharpnessIdealOne_iff 2).2 (Or.inr rfl)
  let E : {f // sharpnessIdealOne.IsPseudoFrobenius f} ≃ Fin 2 :=
    { toFun := fun f ↦ if h : (f : ℤ) = 1 then ⟨0, by omega⟩ else ⟨1, by omega⟩
      invFun := fun k ↦ if (k : ℕ) = 0 then ⟨1, hpf1⟩ else ⟨2, hpf2⟩
      left_inv := fun f ↦ by
        apply Subtype.ext
        rcases (isPseudoFrobenius_sharpnessIdealOne_iff f).1 f.property with hf | hf
        · simp [hf]
        · simp [hf]
      right_inv := fun k ↦ by
        apply Fin.ext
        by_cases hk : (k : ℕ) = 0
        · simp [hk]
        · have hkone : (k : ℕ) = 1 := by omega
          simp [hkone] }
  simpa [idealType] using Nat.card_congr E

/-- The smallest sharpness example realizes equality in the main bound. -/
theorem sharpnessIdealOne_right_equality :
    sharpnessIdealOne.idealType = 2 * sharpnessIdealOne.generatorCount := by
  rw [idealType_sharpnessIdealOne, generatorCount_sharpnessIdealOne]

/-- The canonical dual of the smallest sharpness example realizes equality
in the other half of the two-sided estimate. -/
theorem sharpnessIdealOne_canonicalDual_left_equality :
    sharpnessIdealOne.canonicalDual.generatorCount = 2 ∧
      sharpnessIdealOne.canonicalDual.idealType = 1 := by
  constructor
  · rw [sharpnessIdealOne.generatorCount_canonicalDual, idealType_sharpnessIdealOne]
  · rw [sharpnessIdealOne.idealType_canonicalDual, generatorCount_sharpnessIdealOne]

end RelativeIdeal
end NS25Lean
