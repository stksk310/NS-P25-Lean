import NS25Lean.Sharpness
import Mathlib.Tactic.Ring

set_option linter.style.header false

/-!
# The general sharpness family

This file develops the family `Hₙ = ⟨3n, 3n+1, 3n+2⟩` and its relative
ideal generated by `0,3,…,3n-3`.
-/

namespace NS25Lean

private theorem consecutive_mem_closure_of_ge {m x : ℕ} (hm : 0 < m)
    (hx : m * (m - 1) ≤ x) :
    x ∈ AddSubmonoid.closure ({m, m + 1} : Set ℕ) := by
  let q := x / m
  let r := x % m
  have hrlt : r < m := Nat.mod_lt x hm
  have hq : m - 1 ≤ q := by
    apply (Nat.le_div_iff_mul_le hm).2
    simpa [Nat.mul_comm] using hx
  have hrq : r ≤ q := le_trans (by omega) hq
  have hdecomp : r + m * q = x := Nat.mod_add_div x m
  have hmMem : m ∈ AddSubmonoid.closure ({m, m + 1} : Set ℕ) :=
    AddSubmonoid.subset_closure (by simp)
  have hmOneMem : m + 1 ∈ AddSubmonoid.closure ({m, m + 1} : Set ℕ) :=
    AddSubmonoid.subset_closure (by simp)
  have hleft := (AddSubmonoid.closure ({m, m + 1} : Set ℕ)).nsmul_mem hmMem (q - r)
  have hright := (AddSubmonoid.closure ({m, m + 1} : Set ℕ)).nsmul_mem hmOneMem r
  have hsum := (AddSubmonoid.closure ({m, m + 1} : Set ℕ)).add_mem hleft hright
  have hrep : (q - r) * m + r * (m + 1) = x := by
    calc
      (q - r) * m + r * (m + 1) = ((q - r) + r) * m + r := by ring
      _ = q * m + r := by rw [Nat.sub_add_cancel hrq]
      _ = x := by simpa [Nat.mul_comm, Nat.add_comm] using hdecomp
  rw [← hrep]
  simpa [nsmul_eq_mul] using hsum

/-- The semigroup `Hₙ = ⟨3n,3n+1,3n+2⟩`. -/
def sharpnessSemigroup (n : ℕ) : NumericalSemigroup where
  toAddSubmonoid := AddSubmonoid.closure ({3 * n, 3 * n + 1, 3 * n + 2} : Set ℕ)
  finite_compl := by
    by_cases hn : n = 0
    · subst n
      have htop : AddSubmonoid.closure ({3 * 0, 3 * 0 + 1, 3 * 0 + 2} : Set ℕ) = ⊤ := by
        apply (AddSubmonoid.eq_top_iff' _).2
        intro x
        have hone : 1 ∈ AddSubmonoid.closure ({3 * 0, 3 * 0 + 1, 3 * 0 + 2} : Set ℕ) :=
          AddSubmonoid.subset_closure (by simp)
        simpa using
          (AddSubmonoid.closure ({3 * 0, 3 * 0 + 1, 3 * 0 + 2} : Set ℕ)).nsmul_mem hone x
      rw [htop]
      simp
    · let m := 3 * n
      have hm : 0 < m := by simp [m, Nat.pos_of_ne_zero hn]
      have htail : ∀ x : ℕ, m * (m - 1) ≤ x →
          x ∈ AddSubmonoid.closure ({3 * n, 3 * n + 1, 3 * n + 2} : Set ℕ) := by
        intro x hx
        have hpair := consecutive_mem_closure_of_ge hm hx
        exact AddSubmonoid.closure_mono (by simp [m]) hpair
      apply (Set.finite_lt_nat (m * (m - 1))).subset
      intro x hx
      simp only [Set.mem_ofPred_eq]
      by_contra hnot
      exact hx (htail x (by omega))

namespace sharpnessSemigroup

/-- The displayed three generators generate `Hₙ` by definition. -/
theorem isGeneratedByThree (n : ℕ) :
    (sharpnessSemigroup n).IsGeneratedByThree (3 * n) (3 * n + 1) (3 * n + 2) := rfl

private theorem closure_larger_pair_ge (m x : ℕ)
    (hx : x ∈ AddSubmonoid.closure ({m + 1, m + 2} : Set ℕ)) :
    x = 0 ∨ m + 1 ≤ x := by
  induction hx using AddSubmonoid.closure_induction with
  | mem x hx => simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx; omega
  | zero => exact Or.inl rfl
  | add a b ha hb iha ihb => omega

private theorem closure_first_third_shape (m x : ℕ) (hm : 3 ≤ m)
    (hx : x ∈ AddSubmonoid.closure ({m, m + 2} : Set ℕ)) :
    x = 0 ∨ x = m ∨ x = m + 2 ∨ 2 * m ≤ x := by
  induction hx using AddSubmonoid.closure_induction with
  | mem x hx => simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx; omega
  | zero => exact Or.inl rfl
  | add a b ha hb iha ihb => omega

private theorem closure_first_second_shape (m x : ℕ) (hm : 3 ≤ m)
    (hx : x ∈ AddSubmonoid.closure ({m, m + 1} : Set ℕ)) :
    x = 0 ∨ x = m ∨ x = m + 1 ∨ 2 * m ≤ x := by
  induction hx using AddSubmonoid.closure_induction with
  | mem x hx => simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx; omega
  | zero => exact Or.inl rfl
  | add a b ha hb iha ihb => omega

/-- For `n ≥ 1`, the displayed presentation of `Hₙ` is minimal. -/
theorem isMinimallyGeneratedByThree (n : ℕ) (hn : 1 ≤ n) :
    (sharpnessSemigroup n).IsMinimallyGeneratedByThree
      (3 * n) (3 * n + 1) (3 * n + 2) := by
  let m := 3 * n
  have hm : 3 ≤ m := by simp [m]; omega
  refine ⟨isGeneratedByThree n, ?_, ?_, ?_⟩
  · intro h
    change 3 * n ∈ AddSubmonoid.closure ({3 * n + 1, 3 * n + 2} : Set ℕ) at h
    have := closure_larger_pair_ge m m (by simpa [m] using h)
    omega
  · intro h
    change 3 * n + 1 ∈ AddSubmonoid.closure ({3 * n, 3 * n + 2} : Set ℕ) at h
    have := closure_first_third_shape m (m + 1) hm (by simpa [m] using h)
    omega
  · intro h
    change 3 * n + 2 ∈ AddSubmonoid.closure ({3 * n, 3 * n + 1} : Set ℕ) at h
    have := closure_first_second_shape m (m + 2) hm (by simpa [m] using h)
    omega

/-- Every nonzero element of `Hₙ` is at least `3n`. -/
theorem mem_eq_zero_or_ge (n h : ℕ) (hh : h ∈ sharpnessSemigroup n) :
    h = 0 ∨ 3 * n ≤ h := by
  change h ∈ AddSubmonoid.closure ({3 * n, 3 * n + 1, 3 * n + 2} : Set ℕ) at hh
  induction hh using AddSubmonoid.closure_induction with
  | mem x hx => simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx; omega
  | zero => exact Or.inl rfl
  | add a b ha hb iha ihb => omega

end sharpnessSemigroup

namespace RelativeIdeal

/-- The paper's sharpness ideal
`Deltaₙ = {0,3,…,3n-3} ∪ [3n,∞)` as a relative ideal of `Hₙ`. -/
def sharpnessIdeal (n : ℕ) : RelativeIdeal (sharpnessSemigroup n) where
  carrier := {z : ℤ | (∃ j : ℕ, j < n ∧ z = 3 * j) ∨ (3 * n : ℤ) ≤ z}
  nonempty := ⟨3 * n, Or.inr (by exact_mod_cast le_rfl)⟩
  bddBelow := by
    refine ⟨0, ?_⟩
    rintro z (⟨j, -, rfl⟩ | hz)
    · exact_mod_cast Nat.zero_le (3 * j)
    · have : (0 : ℤ) ≤ (3 * n : ℤ) := by
        exact_mod_cast Nat.zero_le (3 * n)
      omega
  add_mem := by
    intro x h hx hh
    rcases sharpnessSemigroup.mem_eq_zero_or_ge n h hh with rfl | hhlarge
    · simpa using hx
    · right
      have hxnonneg : (0 : ℤ) ≤ x := by
        rcases hx with ⟨j, -, rfl⟩ | hx
        · exact_mod_cast Nat.zero_le (3 * j)
        · have : (0 : ℤ) ≤ (3 * n : ℤ) := by
            exact_mod_cast Nat.zero_le (3 * n)
          omega
      have hhcast : (3 * n : ℤ) ≤ (h : ℤ) := by exact_mod_cast hhlarge
      omega

@[simp] theorem mem_sharpnessIdeal_iff (n : ℕ) (z : ℤ) :
    z ∈ sharpnessIdeal n ↔
      (∃ j : ℕ, j < n ∧ z = 3 * j) ∨ (3 * n : ℤ) ≤ z := Iff.rfl

/-- Every displayed generator `3j`, `j<n`, is a minimal ideal generator. -/
theorem isMinimalGenerator_sharpnessIdeal_mul_three {n j : ℕ}
    (hj : j < n) :
    (sharpnessIdeal n).IsMinimalGenerator (3 * j) := by
  constructor
  · exact Or.inl ⟨j, hj, rfl⟩
  · intro h hh hzero hmem
    have hhlarge := (sharpnessSemigroup.mem_eq_zero_or_ge n h hh).resolve_left hzero
    have hjlt : (3 * j : ℤ) < (3 * n : ℤ) := by exact_mod_cast (by omega : 3 * j < 3 * n)
    have hneg : (3 * j : ℤ) - h < 0 := by
      have hhcast : (3 * n : ℤ) ≤ (h : ℤ) := by exact_mod_cast hhlarge
      omega
    rcases hmem with ⟨k, -, heq⟩ | htail
    · have : (0 : ℤ) ≤ (3 * k : ℤ) := by
        exact_mod_cast Nat.zero_le (3 * k)
      omega
    · omega

/-- The two displayed gaps in each block are pseudo-Frobenius elements. -/
theorem isPseudoFrobenius_sharpnessIdeal_block {n j r : ℕ}
    (hj : j < n) (hr : r = 1 ∨ r = 2) :
    (sharpnessIdeal n).IsPseudoFrobenius (3 * j + r) := by
  constructor
  · intro hmem
    rcases hmem with ⟨k, -, heq⟩ | htail
    · rcases hr with rfl | rfl <;> omega
    · rcases hr with rfl | rfl <;> omega
  · intro h hh hzero
    right
    have hhlarge := (sharpnessSemigroup.mem_eq_zero_or_ge n h hh).resolve_left hzero
    have hhcast : (3 * n : ℤ) ≤ (h : ℤ) := by exact_mod_cast hhlarge
    have hnonneg : (0 : ℤ) ≤ (3 * j + r : ℤ) := by
      exact_mod_cast Nat.zero_le (3 * j + r)
    omega

/-- Exact description of the pseudo-Frobenius set of `Deltaₙ`. -/
theorem isPseudoFrobenius_sharpnessIdeal_iff {n : ℕ} (hn : 1 ≤ n) (f : ℤ) :
    (sharpnessIdeal n).IsPseudoFrobenius f ↔
      ∃ j : ℕ, j < n ∧ (f = 3 * j + 1 ∨ f = 3 * j + 2) := by
  constructor
  · intro hpf
    have hgen := sharpnessSemigroup.isGeneratedByThree n
    have hm0 : 3 * n ≠ 0 := by omega
    have hm10 : 3 * n + 1 ≠ 0 := by omega
    have hm20 : 3 * n + 2 ≠ 0 := by omega
    have htests := ((sharpnessIdeal n).isPseudoFrobenius_iff_add_generators
      hgen hm0 hm10 hm20 f).1 hpf
    rcases htests with ⟨hnot, ha, hb, hc⟩
    have hfnonneg : (0 : ℤ) ≤ f := by
      by_contra h
      have hfneg : f < 0 := by omega
      rcases ha with ⟨ja, -, hea⟩ | hta <;>
        rcases hb with ⟨jb, -, heb⟩ | htb <;>
        rcases hc with ⟨jc, -, hec⟩ | htc <;> omega
    let k := f.toNat
    have hkcast : (k : ℤ) = f := Int.toNat_of_nonneg hfnonneg
    have hklt : k < 3 * n := by
      by_contra h
      apply hnot
      right
      have : (3 * n : ℤ) ≤ (k : ℤ) := by exact_mod_cast (by omega : 3 * n ≤ k)
      rwa [hkcast] at this
    let j := k / 3
    let r := k % 3
    have hrlt : r < 3 := Nat.mod_lt k (by omega)
    have hdecomp : r + 3 * j = k := Nat.mod_add_div k 3
    have hj : j < n := by omega
    have hrzero : r ≠ 0 := by
      intro hr
      apply hnot
      left
      refine ⟨j, hj, ?_⟩
      rw [← hkcast]
      exact_mod_cast (by omega : k = 3 * j)
    have hr : r = 1 ∨ r = 2 := by omega
    refine ⟨j, hj, ?_⟩
    rcases hr with hr | hr
    · left
      rw [← hkcast]
      exact_mod_cast (by omega : k = 3 * j + 1)
    · right
      rw [← hkcast]
      exact_mod_cast (by omega : k = 3 * j + 2)
  · rintro ⟨j, hj, rfl | rfl⟩
    · exact isPseudoFrobenius_sharpnessIdeal_block hj (Or.inl rfl)
    · exact isPseudoFrobenius_sharpnessIdeal_block hj (Or.inr rfl)

/-- Exact description of the minimal generators of `Deltaₙ`. -/
theorem isMinimalGenerator_sharpnessIdeal_iff {n : ℕ} (hn : 1 ≤ n) (x : ℤ) :
    (sharpnessIdeal n).IsMinimalGenerator x ↔
      ∃ j : ℕ, j < n ∧ x = 3 * j := by
  constructor
  · intro hmin
    rcases hmin.1 with hsmall | htail
    · exact hsmall
    · exfalso
      have hxnonneg : (0 : ℤ) ≤ x := by
        have hmnonneg : (0 : ℤ) ≤ (3 * n : ℤ) := by
          exact_mod_cast Nat.zero_le (3 * n)
        omega
      let k := x.toNat
      have hkcast : (k : ℤ) = x := Int.toNat_of_nonneg hxnonneg
      have hklarge : 3 * n ≤ k := by
        have : (3 * n : ℤ) ≤ (k : ℤ) := by rwa [hkcast]
        exact_mod_cast this
      let q := k / 3
      let r := k % 3
      have hrlt : r < 3 := Nat.mod_lt k (by omega)
      have hdecomp : r + 3 * q = k := Nat.mod_add_div k 3
      have hq : n ≤ q := by omega
      have hr : r = 0 ∨ r = 1 ∨ r = 2 := by omega
      let h := 3 * n + r
      have hh : h ∈ sharpnessSemigroup n := by
        change h ∈ AddSubmonoid.closure ({3 * n, 3 * n + 1, 3 * n + 2} : Set ℕ)
        apply AddSubmonoid.subset_closure
        rcases hr with hr | hr | hr <;> simp [h, hr]
      have hzero : h ≠ 0 := by simp [h]; omega
      have hle : h ≤ k := by simp [h]; omega
      have hdiff : k - h = 3 * (q - n) := by simp [h]; omega
      apply hmin.2 h hh hzero
      have hdiffMem : ((k - h : ℕ) : ℤ) ∈ sharpnessIdeal n := by
        rw [hdiff]
        by_cases hqn : q - n < n
        · left
          exact ⟨q - n, hqn, by norm_num⟩
        · right
          exact_mod_cast (by omega : 3 * n ≤ 3 * (q - n))
      have hcastdiff : ((k - h : ℕ) : ℤ) = x - h := by
        rw [Nat.cast_sub hle, hkcast]
      rwa [← hcastdiff]
  · rintro ⟨j, hj, rfl⟩
    exact isMinimalGenerator_sharpnessIdeal_mul_three hj

/-- The sharpness ideal has type exactly `2n`. -/
theorem idealType_sharpnessIdeal {n : ℕ} (hn : 1 ≤ n) :
    (sharpnessIdeal n).idealType = 2 * n := by
  let F : Fin n × Fin 2 → {f // (sharpnessIdeal n).IsPseudoFrobenius f} := fun p ↦
    ⟨3 * (p.1 : ℕ) + ((p.2 : ℕ) + 1),
      isPseudoFrobenius_sharpnessIdeal_block p.1.isLt (by
        have hp2 : (p.2 : ℕ) = 0 ∨ (p.2 : ℕ) = 1 := by
          have := p.2.isLt
          omega
        rcases hp2 with hp2 | hp2
        · left; simp [hp2]
        · right; simp [hp2])⟩
  have hinj : Function.Injective F := by
    intro p q hpq
    apply Prod.ext
    · apply Fin.ext
      have hv := congrArg (fun z : {f // (sharpnessIdeal n).IsPseudoFrobenius f} ↦ (z : ℤ)) hpq
      dsimp [F] at hv
      omega
    · apply Fin.ext
      have hv := congrArg (fun z : {f // (sharpnessIdeal n).IsPseudoFrobenius f} ↦ (z : ℤ)) hpq
      dsimp [F] at hv
      omega
  have hsurj : Function.Surjective F := by
    intro f
    obtain ⟨j, hj, hf | hf⟩ := (isPseudoFrobenius_sharpnessIdeal_iff hn f).1 f.property
    · refine ⟨⟨⟨j, hj⟩, ⟨0, by omega⟩⟩, ?_⟩
      apply Subtype.ext
      simpa [F] using hf.symm
    · refine ⟨⟨⟨j, hj⟩, ⟨1, by omega⟩⟩, ?_⟩
      apply Subtype.ext
      simpa [F] using hf.symm
  let E : Fin n × Fin 2 ≃ {f // (sharpnessIdeal n).IsPseudoFrobenius f} :=
    Equiv.ofBijective F ⟨hinj, hsurj⟩
  have hcard := Nat.card_congr E
  simpa [idealType, Nat.mul_comm] using hcard.symm

/-- The sharpness ideal has exactly `n` minimal generators. -/
theorem generatorCount_sharpnessIdeal {n : ℕ} (hn : 1 ≤ n) :
    (sharpnessIdeal n).generatorCount = n := by
  let F : Fin n → {x // (sharpnessIdeal n).IsMinimalGenerator x} := fun j ↦
    ⟨3 * (j : ℕ), isMinimalGenerator_sharpnessIdeal_mul_three j.isLt⟩
  have hinj : Function.Injective F := by
    intro j k hjk
    apply Fin.ext
    have hv := congrArg (fun z : {x // (sharpnessIdeal n).IsMinimalGenerator x} ↦ (z : ℤ)) hjk
    dsimp [F] at hv
    omega
  have hsurj : Function.Surjective F := by
    intro x
    obtain ⟨j, hj, hx⟩ := (isMinimalGenerator_sharpnessIdeal_iff hn x).1 x.property
    refine ⟨⟨j, hj⟩, ?_⟩
    apply Subtype.ext
    simpa [F] using hx.symm
  let E : Fin n ≃ {x // (sharpnessIdeal n).IsMinimalGenerator x} :=
    Equiv.ofBijective F ⟨hinj, hsurj⟩
  have hcard := Nat.card_congr E
  simpa [generatorCount] using hcard.symm

/-- **NS25 Milestone C.** The full family realizes equality in the main bound
for every prescribed positive generator count. -/
theorem sharpnessFamily_equality {n : ℕ} (hn : 1 ≤ n) :
    (sharpnessIdeal n).generatorCount = n ∧
      (sharpnessIdeal n).idealType = 2 * (sharpnessIdeal n).generatorCount := by
  rw [generatorCount_sharpnessIdeal hn, idealType_sharpnessIdeal hn]
  exact ⟨rfl, rfl⟩

/-- An explicit shift beyond the conductor bound used for the integral
sharpness example. -/
def sharpnessIntegralShift (n : ℕ) : ℕ :=
  (3 * n) * (3 * n - 1)

/-- The translated sharpness ideal lying inside `Hₙ`. -/
def sharpnessIntegralIdeal (n : ℕ) : RelativeIdeal (sharpnessSemigroup n) :=
  (sharpnessIdeal n).translate (sharpnessIntegralShift n)

private theorem sharpnessIntegralShift_le_mem {n k : ℕ} (hn : 1 ≤ n)
    (hk : sharpnessIntegralShift n ≤ k) : k ∈ sharpnessSemigroup n := by
  let m := 3 * n
  have hm : 0 < m := by simp [m]; omega
  have hpair : k ∈ AddSubmonoid.closure ({m, m + 1} : Set ℕ) := by
    apply consecutive_mem_closure_of_ge hm
    simpa [sharpnessIntegralShift, m] using hk
  change k ∈ AddSubmonoid.closure ({3 * n, 3 * n + 1, 3 * n + 2} : Set ℕ)
  exact AddSubmonoid.closure_mono (by simp [m]) hpair

/-- The translated example is integral: every one of its elements belongs to
the embedded semigroup `Hₙ`. -/
theorem sharpnessIntegralIdeal_subset_semigroup {n : ℕ} (hn : 1 ≤ n) {z : ℤ}
    (hz : z ∈ sharpnessIntegralIdeal n) :
    z ∈ (sharpnessSemigroup n).asRelativeIdeal := by
  rw [sharpnessIntegralIdeal, mem_translate_iff] at hz
  have hnonnegDiff : (0 : ℤ) ≤ z - sharpnessIntegralShift n := by
    rcases hz with ⟨j, -, heq⟩ | htail
    · have : (0 : ℤ) ≤ (3 * j : ℤ) := by
        exact_mod_cast Nat.zero_le (3 * j)
      omega
    · have hmnonneg : (0 : ℤ) ≤ (3 * n : ℤ) := by
        exact_mod_cast Nat.zero_le (3 * n)
      omega
  have hznonneg : (0 : ℤ) ≤ z := by
    have hshift : (0 : ℤ) ≤ (sharpnessIntegralShift n : ℤ) := by
      exact_mod_cast Nat.zero_le (sharpnessIntegralShift n)
    omega
  let k := z.toNat
  have hkcast : (k : ℤ) = z := Int.toNat_of_nonneg hznonneg
  have hkshift : sharpnessIntegralShift n ≤ k := by
    have : (sharpnessIntegralShift n : ℤ) ≤ (k : ℤ) := by
      rw [hkcast]
      omega
    exact_mod_cast this
  exact ⟨k, sharpnessIntegralShift_le_mem hn hkshift, hkcast.symm⟩

/-- The complement of the translated ideal inside `Hₙ` is finite. -/
theorem sharpnessIntegralIdeal_cofinite {n : ℕ} (hn : 1 ≤ n) :
    Set.Finite {k : ℕ | k ∈ sharpnessSemigroup n ∧
      (k : ℤ) ∉ sharpnessIntegralIdeal n} := by
  let bound := sharpnessIntegralShift n + 3 * n
  apply (Set.finite_lt_nat bound).subset
  intro k hk
  simp only [Set.mem_ofPred_eq]
  by_contra hnotlt
  apply hk.2
  rw [sharpnessIntegralIdeal, mem_translate_iff]
  right
  have hbound : bound ≤ k := by omega
  have hcast : (bound : ℤ) ≤ (k : ℤ) := by exact_mod_cast hbound
  simp only [bound] at hcast
  omega

/-- Translation preserves both sharpness counts for the integral cofinite
version of the family. -/
theorem sharpnessIntegralFamily_counts {n : ℕ} (hn : 1 ≤ n) :
    (sharpnessIntegralIdeal n).generatorCount = n ∧
      (sharpnessIntegralIdeal n).idealType = 2 * n := by
  constructor
  · rw [sharpnessIntegralIdeal, generatorCount_translate,
      generatorCount_sharpnessIdeal hn]
  · rw [sharpnessIntegralIdeal, idealType_translate,
      idealType_sharpnessIdeal hn]

/-- Canonical duality reverses the two counts throughout the sharpness
family, giving the equality family for the left-hand bound as well. -/
theorem sharpnessFamily_canonicalDual_counts {n : ℕ} (hn : 1 ≤ n) :
    (sharpnessIdeal n).canonicalDual.generatorCount = 2 * n ∧
      (sharpnessIdeal n).canonicalDual.idealType = n := by
  constructor
  · rw [(sharpnessIdeal n).generatorCount_canonicalDual,
      idealType_sharpnessIdeal hn]
  · rw [(sharpnessIdeal n).idealType_canonicalDual,
      generatorCount_sharpnessIdeal hn]

/-- The canonical-dual family attains equality in
`generatorCount ≤ 2 * idealType`. -/
theorem sharpnessFamily_canonicalDual_equality {n : ℕ} (hn : 1 ≤ n) :
    (sharpnessIdeal n).canonicalDual.generatorCount =
      2 * (sharpnessIdeal n).canonicalDual.idealType := by
  obtain ⟨hmu, ht⟩ := sharpnessFamily_canonicalDual_counts hn
  rw [hmu, ht]

end RelativeIdeal
end NS25Lean
