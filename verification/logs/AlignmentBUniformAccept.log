theorem NS25Lean.L5A2BFinalRepair.nonsymmetric_prefix_diagram_outer_b : ∀ {Gamma : NumericalSemigroup}
  {P : P2Data Gamma} (R : SectorBCriticalRoleBranchB P) (hB : SectorB P.M) (hQ : 1 < actualPrincipalIndex P.M.base)
  {y : ℕ},
  y < nsQ R →
    nonsymmetricPrefixDiagramHeight R hB hQ 0 (y + nsV R) ≤
      nonsymmetricPrefixDiagramHeight R hB hQ (nsC2 R - 1) y + nsU R :=
fun {Gamma} {P} R hB hQ {y} hy =>
  Eq.mpr
    (id
      (congr (congrArg LE.le (nonsymmetric_prefix_height_eq_uniform R hB hQ 0 (y + nsV R)))
        (congrFun' (congrArg HAdd.hAdd (nonsymmetric_prefix_height_eq_uniform R hB hQ (nsC2 R - 1) y)) (nsU R))))
    (BranchBUniformMinPlus.outer_b (nonsymmetricUniformMinPlusData R hB hQ) hy)
theorem NS25Lean.L5A2BFinalRepair.nonsymmetric_prefix_diagram_height_lt_c1 : ∀ {Gamma : NumericalSemigroup}
  {P : P2Data Gamma} (R : SectorBCriticalRoleBranchB P) (hB : SectorB P.M) (hQ : 1 < actualPrincipalIndex P.M.base)
  (x y : ℕ), nonsymmetricPrefixDiagramHeight R hB hQ x y < nsC1 R :=
fun {Gamma} {P} R hB hQ x y =>
  BranchBUniformMinPlus.candidate_lt_c1 (nonsymmetricUniformMinPlusData R hB hQ)
    (nonsymmetric_prefix_diagram_height_attained R hB hQ x y)
theorem NS25Lean.L5A2BFinalRepair.symmetric_actual_type_le_sourceCount : ∀ {Gamma : NumericalSemigroup}
  {P : P2Data Gamma} (A : SectorBCriticalRoleBranchA P),
  SectorB P.M → Gamma.asRelativeIdeal.idealType ≤ P.sourceCount :=
fun {Gamma} {P} A hB =>
  have hp := (actualPrincipalIndex_spec P.M.base).left;
  if hQ : actualPrincipalIndex P.M.base = 1 then
    And.casesOn (symmetric_Q_one_actual_type_and_sourceCount A hQ) fun ht hs =>
      Decidable.byContradiction fun a => symmetric_actual_type_le_sourceCount._proof_1_1 ht hs a
  else
    symmetric_Q_gt_one_actual_type_le_sourceCount_uniform A hB
      (Decidable.byContradiction fun a => symmetric_actual_type_le_sourceCount._proof_1_2 hp hQ a)
theorem NS25Lean.L5A2BFinalRepair.symmetric_Q_gt_one_actual_type_le_sourceCount_uniform : ∀ {Gamma : NumericalSemigroup}
  {P : P2Data Gamma} (A : SectorBCriticalRoleBranchA P),
  SectorB P.M → 1 < actualPrincipalIndex P.M.base → Gamma.asRelativeIdeal.idealType ≤ P.sourceCount :=
fun {Gamma} {P} A hB hQ =>
  LE.le.trans (symmetric_principal_socle_gain_le_two_uniform A hB hQ)
    (symmetric_prefix_socle_plus_two_le_actual_sourceCount_uniform A hB hQ)
