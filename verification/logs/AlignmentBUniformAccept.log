NS25Lean.L5A2BFinalRepair.nonsymmetric_prefix_height_formula {Gamma : NumericalSemigroup} {P : P2Data Gamma}
  (R : SectorBCriticalRoleBranchB P) (hB : SectorB P.M) (hQ : 1 < actualPrincipalIndex P.M.base) {x y : ℕ}
  (hdom : NonsymmetricLDomain R x y) :
  nonsymmetricPrefixLambda R hQ (gridResidue P.M.base (nsReindex R) x y) =
    ↑(nonsymmetricPrefixDiagramHeight R hB hQ x y) * ↑(nsA R) + ↑x * ↑(nsB R) + ↑y * ↑(nsC R)
