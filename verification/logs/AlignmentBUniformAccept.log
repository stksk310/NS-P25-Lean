NS25Lean.L5A2BFinalRepair.symmetric_prefix_C_targets_F {Gamma : NumericalSemigroup} {P : P2Data Gamma}
  (A : SectorBCriticalRoleBranchA P) (hB : SectorB P.M) (hQ : 2 < actualPrincipalIndex P.M.base) :
  have I := symmetricPrefixIdeal A ⋯;
  have D := symmetricPrefixRouting A ⋯;
  ∀ (r : ZMod (routingA P.M.base A.reindex)),
    D.IsBranch r →
      D.IsSource (D.branchTarget r) →
        ∃ ell,
          I.aperyRepresentative (routingA P.M.base A.reindex) (D.branchTarget r) =
            ↑(symmetricF A (symmetricReturnTuple A hB ell).1 (symmetricReturnTuple A hB ell).2.1)
NS25Lean.L5A2BFinalRepair.symmetric_prefix_resource_bounds {Gamma : NumericalSemigroup} {P : P2Data Gamma}
  (A : SectorBCriticalRoleBranchA P) (hB : SectorB P.M) (hQ : 2 < actualPrincipalIndex P.M.base) :
  have hQ1 := ⋯;
  have D := symmetricPrefixRouting A hQ1;
  have r := Nat.card (SymmetricMinimalFPoints A hB);
  L5A2C4I.ResidueData.sourceTargetBranchCount D ≤ r ∧
    r ≤ Nat.card (L5A2C4I.ResidueData.ExactUnusedMergeBases D) ∧
      fakeSinkCount (symmetricPrefixIdeal A hQ1) (routingA P.M.base A.reindex) (routingB P.M.base A.reindex)
          (routingC P.M.base A.reindex) ⋯ ⋯ =
        1
NS25Lean.L5A2BFinalRepair.symmetric_prefix_socle_plus_two_le_actual_sourceCount {Gamma : NumericalSemigroup}
  {P : P2Data Gamma} (A : SectorBCriticalRoleBranchA P) (hB : SectorB P.M) (hQ : 2 < actualPrincipalIndex P.M.base) :
  have hQ1 := ⋯;
  actualSinkCount (symmetricPrefixIdeal A hQ1) (routingA P.M.base A.reindex) (routingB P.M.base A.reindex)
        (routingC P.M.base A.reindex) ⋯ ⋯ +
      2 ≤
    P.sourceCount
