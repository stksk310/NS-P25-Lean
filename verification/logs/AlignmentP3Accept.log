NS25Lean.P3CommonFinal.euler_total.{u_1} {R : Type u_1} [Fintype R] (D : NS25Lean.CombinatorialCore.ResidueData R) :
  D.sinkCount + Nat.card (NS25Lean.L5A2C4I.ResidueData.ExactUnusedMergeBases D) =
    D.sourceCount + NS25Lean.L5A2C4I.ResidueData.sourceTargetBranchCount D
NS25Lean.P3CommonFinal.same_final_partitions.{u_1} {R : Type u_1} [Fintype R]
  (D : NS25Lean.CombinatorialCore.ResidueData R) :
  NS25Lean.L5A2C4I.ResidueData.sourceTargetBranchCount D =
      Nat.card (NS25Lean.L5A2C4I.ResidueData.CUsedFirstStageBases D) +
        NS25Lean.L5A2C4I.ResidueData.cExceptionalCount D ∧
    Nat.card (NS25Lean.L5A2C4I.ResidueData.ExactUnusedMergeBases D) =
      Nat.card (NS25Lean.L5A2C4I.ResidueData.CUsedFirstStageBases D) +
        Nat.card (NS25Lean.L5A2C4I.ResidueData.CFreshUnusedMergeBases D)
