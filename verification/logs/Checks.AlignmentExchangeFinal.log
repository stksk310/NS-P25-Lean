NS25Lean.GenericCriticalDuality.compensation_source_count {H : NS25Lean.NumericalSemigroup}
  {B : NS25Lean.CriticalCapGeometry.Base H} {D : NS25Lean.CriticalPresentationModes.Mode B}
  (F : NS25Lean.CriticalFullSignature.Front B D) :
  (NS25Lean.GenericCriticalDuality.additional F).ncard +
      Nat.card { s // 0 < (B.norm s) 0 ∧ 0 < (B.norm s) 1 ∧ 0 < (B.norm s) 2 } ≤
    (NS25Lean.GenericCriticalDuality.exceptional F).ncard
NS25Lean.GenericCriticalDuality.fullSupport_source_count {H : NS25Lean.NumericalSemigroup}
  {B : NS25Lean.CriticalCapGeometry.Base H} {D : NS25Lean.CriticalPresentationModes.Mode B}
  (F : NS25Lean.CriticalFullSignature.Front B D) :
  NS25Lean.GenericCriticalDuality.fullSupport F =
    Nat.card { s // 0 < (B.norm s) 0 ∧ 0 < (B.norm s) 1 ∧ 0 < (B.norm s) 2 }
NS25Lean.GenericCriticalDuality.fullSupport_original_count {H : NS25Lean.NumericalSemigroup}
  {B : NS25Lean.CriticalCapGeometry.Base H} {D : NS25Lean.CriticalPresentationModes.Mode B}
  (F : NS25Lean.CriticalFullSignature.Front B D) :
  NS25Lean.GenericCriticalDuality.fullSupport F = (NS25Lean.GenericCriticalDuality.fullOriginals F).ncard
