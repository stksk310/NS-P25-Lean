NS25Lean.GenericFloorStaircase.floor_staircase_family {H : NumericalSemigroup} (I : RelativeIdeal H) (a b c : ℕ)
  [NeZero a] (hb : b ∈ H) (hc : c ∈ H) (hsub : ∀ z ∈ I, z ∈ H.asRelativeIdeal) (Imax Jmax : ℕ) (S : Finset (ℕ × ℕ))
  (hS : S.Nonempty)
  (hcan :
    ∀ (i j : ℕ), i < Imax → j < Jmax → H.asRelativeIdeal.aperyRepresentative a ↑(↑i * ↑b + ↑j * ↑c) = ↑i * ↑b + ↑j * ↑c)
  (hinjective :
    ∀ (i j i' j' : ℕ),
      i < Imax → j < Jmax → i' < Imax → j' < Jmax → ↑(↑i * ↑b + ↑j * ↑c) = ↑(↑i' * ↑b + ↑j' * ↑c) → i = i' ∧ j = j')
  (hbounds : ∀ p ∈ S, p.1 < Imax ∧ p.2 < Jmax)
  (hfloor : ∀ (i j : ℕ), i < Imax → j < Jmax → (↑i * ↑b + ↑j * ↑c ∈ I ↔ ∃ p ∈ S, p.1 ≤ i ∧ p.2 ≤ j)) :
  ∃ base,
    Function.Injective base ∧
      (∀ (k : Fin ((P3R67.coordinateMinima S).card - 1)),
          L5A2C4I.ResidueData.ExactUnusedMergeReverseBase (P3R60.idealData I a b c hb hc) (base k)) ∧
        ∀ (k : Fin ((P3R67.coordinateMinima S).card - 1)),
          ∃ p ∈ S, ∃ q ∈ S, p.1 < q.1 ∧ q.2 < p.2 ∧ base k = ↑(↑(q.1 - 1) * ↑b + ↑(p.2 - 1) * ↑c)
