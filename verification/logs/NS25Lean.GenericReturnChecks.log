  (hr : RB (actualPositive B e HD) i j d ∨ GenericReturn.LT (actualPositive B e HD) i j d)
  (he : ↑i * ↑(L5A2C4H.routingB B e) + ↑j * ↑(L5A2C4H.routingC B e) = ↑nu + ↑d * ↑(L5A2C4H.routingA B e)) (x : ℤ) :
  have R := actualReturn B e HD nu i j d hr he;
  x ∈ L5A2B4AR1.returnIdeal (L5A2C4H.routingH B e) nu ↔
    x - R.F ∈ (L5A2C4H.routingH B e).asRelativeIdeal ∨
      x - R.X ∈ (L5A2C4H.routingH B e).asRelativeIdeal ∨ x - R.Y ∈ (L5A2C4H.routingH B e).asRelativeIdeal
