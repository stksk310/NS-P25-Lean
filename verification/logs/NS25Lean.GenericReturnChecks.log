  ∃! t, (RB D t.1 t.2.1 t.2.2 ∨ GenericReturn.LT D t.1 t.2.1 t.2.2) ∧ t.1 * D.b + t.2.1 * D.c = nu + t.2.2 * D.a
NS25Lean.GenericReturn.all_live_critical_predecessors_absent {H : NumericalSemigroup} (D : Positive H) (K : LocalCut D)
  (nu : ℕ) (hnu : 0 < nu) (hnon : nu ∉ H) (hRK : ∀ (x : ℕ), InReturn H nu x → x ∈ K.carrier) :
  ¬InReturn H nu ((D.B - 1) * D.b) ∧
    ¬InReturn H nu ((D.u - 1) * D.a + D.v * D.c) ∧
      ¬InReturn H nu (D.u * D.a + (D.v - 1) * D.c) ∧
        ¬InReturn H nu ((D.C - 1) * D.c) ∧
          ¬InReturn H nu ((D.w - 1) * D.a + D.z * D.b) ∧ ¬InReturn H nu (D.w * D.a + (D.z - 1) * D.b)
