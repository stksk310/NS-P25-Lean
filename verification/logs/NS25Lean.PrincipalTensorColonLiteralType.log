    ↑(Nat.card { w // IsIntegralSocle I w }) - ↑(Nat.card (ReturnExchange.IdealSources H (naturalCarrier I))) + 1 +
      ↑(Nat.card { s // ReturnExchange.PrincipalErased H (↑f) s })
